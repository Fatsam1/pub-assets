  <% } %>
  <% if (tpl.key === 'instagram') { %>
    <div style="margin-top:14px;text-align:center;font-size:.85rem;color:#737373">Don't have an account? <a href="#" onclick="return false" style="color:#262626;font-weight:600">Sign up</a></div>
  <% } %>
  <% if (tpl.key === 'gmail' || tpl.key === 'google') { %>
    <div style="margin-top:14px;text-align:center;font-size:.8rem;color:#5f6368"><a href="#" onclick="return false" style="color:#1a73e8">Not your computer? Use a private browsing window to sign in.</a></div>
  <% } %>
  <% if (tpl.key === 'paypal') { %>
    <div style="margin-top:12px;text-align:center;font-size:.85rem;color:#6c7378"><a href="#" onclick="return false" style="color:#0070ba">Forgot email or password?</a></div>
    <div style="margin-top:8px;text-align:center;font-size:.85rem;color:#6c7378">New to PayPal? <a href="#" onclick="return false" style="color:#0070ba;font-weight:600">Sign Up</a></div>
