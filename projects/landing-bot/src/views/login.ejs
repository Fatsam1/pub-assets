<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= pageContent.headline %> — <%= tpl.name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:<%= tpl.palette.bg %>;
    --card:<%= tpl.palette.card %>;
    --fg:<%= tpl.palette.fg %>;
    --accent:<%= tpl.palette.accent %>;
    --accent2:<%= tpl.palette.accent2 %>;
  }
  * { box-sizing:border-box; margin:0; padding:0; }
  body {
    font-family:'Cairo',system-ui;
    background:var(--bg); color:var(--fg);
    min-height:100vh;
    display:flex; align-items:center; justify-content:center;
    padding:24px;
  }
  .auth {
    background:var(--card);
    border-radius:22px;
    padding:38px 30px;
    width:100%; max-width:420px;
    box-shadow:0 30px 70px rgba(0,0,0,.5);
    border:1px solid rgba(255,255,255,.07);
  }
  .logo {
    width:60px; height:60px; border-radius:17px;
    background:linear-gradient(135deg,var(--accent),var(--accent2));
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-weight:800; font-size:1.7rem;
    margin:0 auto 22px;
    box-shadow:0 8px 24px rgba(0,0,0,.3);
  }
  h1 { font-size:1.35rem; text-align:center; margin-bottom:6px; font-weight:800; }
  .sub { text-align:center; font-size:.9rem; opacity:.65; margin-bottom:28px; }
  form { display:grid; gap:13px; }
  input {
    padding:14px 16px; border-radius:13px;
    border:1.5px solid rgba(255,255,255,.1);
    background:rgba(0,0,0,.25); color:var(--fg);
    font-size:1rem; font-family:inherit; width:100%;
    transition:.2s;
  }
  input:focus { outline:none; border-color:var(--accent); background:rgba(0,0,0,.35); }
  input::placeholder { opacity:.5; }
  button {
    padding:15px; border:0; border-radius:13px;
    background:linear-gradient(135deg,var(--accent),var(--accent2));
    color:#fff; font-size:1.05rem; font-weight:800;
    cursor:pointer; font-family:inherit; width:100%;
    transition:.2s; margin-top:2px;
  }
  button:hover { transform:translateY(-2px); filter:brightness(1.08); }
  button:active { transform:translateY(0); }
</style>
</head>
<body>
<div class="auth">
  <div class="logo"><%= tpl.name.charAt(0).toUpperCase() %></div>
  <h1><%= pageContent.headline %></h1>
  <% if (pageContent.subheadline) { %><p class="sub"><%= pageContent.subheadline %></p><% } %>

  <form method="POST" action="/p/<%= page.slug %>/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% pageContent.fields.forEach(f => {
      const type = f === 'password' ? 'password' : f === 'email' ? 'email' : f === 'phone' ? 'tel' : 'text';
      const placeholder = {
        email: 'البريد الإلكتروني',
        password: 'كلمة المرور',
        phone: 'رقم الجوال',
        username: 'اسم المستخدم',
        name: 'الاسم'
      }[f] || f;
    %>
      <input type="<%= type %>" name="<%= f %>" placeholder="<%= placeholder %>" autocomplete="<%= f === 'password' ? 'current-password' : f %>" required>
    <% }) %>
    <button type="submit"><%= pageContent.cta || 'تسجيل الدخول' %></button>
  </form>
</div>
</body>
</html>
