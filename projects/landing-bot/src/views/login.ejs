  body.brand-google .auth, body.brand-gmail .auth { background:#fff; border:1px solid #dadce0; border-radius:8px; box-shadow:none; }
  body.brand-google h1, body.brand-gmail h1 { color:#202124; font-weight:400; font-size:1.5rem; }
  body.brand-google .sub, body.brand-gmail .sub { color:#5f6368; opacity:1; }
