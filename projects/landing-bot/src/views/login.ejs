  body.brand-facebook input:focus { border-color:#1877F2; box-shadow:0 0 0 2px rgba(24,119,242,.2); background:#fff; }
  body.brand-facebook button { background:#1877F2; border-radius:6px; background-image:none; font-weight:700; letter-spacing:.3px; }
  body.brand-facebook button:hover { background:#166fe5; transform:none; filter:none; }

