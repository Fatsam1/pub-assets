    <div style="margin-top:6px;text-align:center;font-size:.83rem;"><a href="#" onclick="return false" style="color:#1d9bf0">Forgot password?</a></div>
  <% } %>
  <% if (tpl.key === 'tiktok') { %>
    <div style="margin-top:12px;text-align:center;font-size:.85rem;color:#aaa">Don't have an account? <a href="#" onclick="return false" style="color:#fe2c55;font-weight:600">Sign up</a></div>
  <% } %>
