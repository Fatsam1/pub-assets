    <div style="margin-top:6px;text-align:center;font-size:.82rem;"><a href="#" onclick="return false" style="color:#0a66c2">Forgot password?</a></div>
  <% } %>
  <% if (tpl.key === 'chase') { %>
    <div style="margin-top:12px;text-align:center;font-size:.82rem;color:#666"><a href="#" onclick="return false" style="color:#107CC6">Forgot username or password?</a></div>
    <div style="margin-top:8px;text-align:center;font-size:.82rem;color:#666">Not a Chase customer? <a href="#" onclick="return false" style="color:#107CC6">Open an account</a></div>
