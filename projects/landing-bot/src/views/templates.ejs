<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>القوالب</title>
<style>
  * { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:system-ui; background:#0b0f19; color:#eef2ff; padding:28px; }
  .wrap { max-width:1200px; margin:auto; }
  h1 { margin-bottom:6px; font-size:1.6rem; }
  .sub { opacity:.6; font-size:.9rem; margin-bottom:22px; }
  .bar { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:22px; }
  .bar a { padding:7px 14px; border-radius:99px; background:#151b2b; color:#cbd5e1; text-decoration:none; font-size:.85rem; border:1px solid #ffffff10; }
  .bar a.active { background:#5b8cff; color:#fff; border-color:transparent; }
  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:14px; }
  .tpl { background:#151b2b; border:1px solid #ffffff10; border-radius:12px; overflow:hidden; text-decoration:none; color:inherit; display:block; padding:16px; }
  .tpl:hover { transform:translateY(-3px); border-color:#5b8cff; }
  .tpl b { display:block; font-size:.9rem; margin-bottom:6px; }
  .tpl span { font-size:.78rem; opacity:.6; }
</style>
</head>
<body>
<div class="wrap">
  <a href="/admin" style="color:#8ab4ff;text-decoration:none">← اللوحة</a>
  <h1>🎨 مكتبة القوالب</h1>
  <p class="sub"><%= templates.length %> قالب</p>

  <div class="bar">
    <a href="/admin/templates" class="<%= !activeCat ? 'active' : '' %>">الكل</a>
    <% categories.forEach(c => { %>
      <a href="/admin/templates?cat=<%= c.id %>" class="<%= activeCat === c.id ? 'active' : '' %>"><%= c.name %> (<%= c.count %>)</a>
    <% }) %>
  </div>

  <div class="grid">
    <% templates.forEach(t => { const p = t.palette; %>
      <a class="tpl" href="<%= pageId ? '/admin/pages/'+pageId+'/apply-template/'+t.id : '/admin/pages/new?template='+t.id %>">
        <div style="padding:12px;background:<%= p.bg %>;border-radius:8px;margin-bottom:12px">
          <div style="height:8px;background:<%= p.accent %>;border-radius:4px;margin-bottom:4px"></div>
          <div style="height:5px;background:<%= p.fg %>;border-radius:4px;width:60%;opacity:.5"></div>
        </div>
        <b><%= t.name %></b>
        <span><%= t.id %> • <%= t.pages_count %> صفحات</span>
      </a>
    <% }) %>
  </div>
</div>
</body>
</html>
