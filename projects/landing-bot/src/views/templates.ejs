<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Templates — LandingBot</title>
<style>
:root{
  --bg:#0e1116;--surface:#161b22;--surface2:#1c232d;--line:#2a323d;
  --ink:#e8eaed;--ink2:#aab1bb;--ink3:#79818c;--ink4:#4a5160;
  --accent:#4b93ff;--accent-soft:#16273f;
  --good:#4ac57e;--warn:#e0ad46;--crit:#f0766b;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --mono:ui-monospace,"Cascadia Code","Roboto Mono",Menlo,Consolas,monospace;
  --r8:8px;--r12:12px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scrollbar-width:thin;scrollbar-color:var(--line) var(--bg)}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;min-height:100vh}
a{color:inherit;text-decoration:none}

.topbar{height:52px;display:flex;align-items:center;gap:12px;padding:0 20px;
        background:var(--surface);border-bottom:1px solid var(--line);
        position:sticky;top:0;z-index:200}
.tb-back{display:flex;align-items:center;gap:6px;color:var(--ink3);font-size:.82rem;
         padding:5px 10px;border-radius:var(--r8);border:1px solid var(--line);
         transition:.15s}
.tb-back:hover{color:var(--ink);background:var(--surface2)}
.tb-title{font-weight:700;font-size:.95rem}
.tb-count{font-family:var(--mono);font-size:.75rem;color:var(--ink3);
          background:var(--surface2);padding:2px 8px;border-radius:20px;border:1px solid var(--line)}

.wrap{max-width:1280px;margin:0 auto;padding:24px 20px 80px}

.filter-bar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px;align-items:center}
.filter-bar input{padding:8px 12px;background:var(--surface);border:1px solid var(--line);
                  border-radius:var(--r8);color:var(--ink);font-size:.82rem;
                  font-family:var(--sans);width:200px}
.filter-bar input:focus{outline:none;border-color:var(--accent)}
.cat-btn{padding:6px 14px;border-radius:99px;background:var(--surface);color:var(--ink3);
         font-size:.8rem;border:1px solid var(--line);cursor:pointer;transition:.15s}
.cat-btn:hover{color:var(--ink);background:var(--surface2)}
.cat-btn.active{background:var(--accent);color:#fff;border-color:transparent}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px}

.tpl{background:var(--surface);border:1px solid var(--line);border-radius:var(--r12);
     overflow:hidden;cursor:pointer;transition:.2s;display:block}
.tpl:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 4px 16px #0006}
.tpl.hidden{display:none}
.tpl-preview{padding:14px;background:var(--surface2)}
.tpl-swatch{height:7px;border-radius:4px;margin-bottom:5px}
.tpl-swatch2{height:4px;border-radius:4px;width:55%;opacity:.45}
.tpl-body{padding:12px 14px}
.tpl-name{font-size:.85rem;font-weight:600;margin-bottom:3px;
          white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tpl-meta{font-family:var(--mono);font-size:.72rem;color:var(--ink3)}
.tpl-pages{font-size:.72rem;color:var(--ink4);margin-top:2px}

.empty-state{text-align:center;padding:80px 20px;color:var(--ink4)}
</style>
</head>
<body>

<div class="topbar">
  <a class="tb-back" href="/admin<%= pageId ? '/pages/'+pageId : '' %>">
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2L4 6l4 4"/></svg>
    Back
  </a>
  <span class="tb-title">Templates</span>
  <span class="tb-count"><%= templates.length %> templates</span>
</div>

<div class="wrap">
  <div class="filter-bar">
    <input type="text" id="searchTpl" placeholder="Search templates…" oninput="filterTemplates()">
    <a href="/admin/templates<%= pageId ? '?page_id='+pageId : '' %>" class="cat-btn <%= !activeCat ? 'active' : '' %>">All (<%= categories.reduce((s,c)=>s+c.count,0) %>)</a>
    <% categories.forEach(c => { %>
      <a href="/admin/templates?cat=<%= c.id %><%= pageId ? '&page_id='+pageId : '' %>" class="cat-btn <%= activeCat === c.id ? 'active' : '' %>">
        <%= c.name %> (<%= c.count %>)
      </a>
    <% }) %>
  </div>

  <div class="grid" id="tplGrid">
    <% templates.forEach(t => { const p = t.palette; %>
      <a class="tpl" href="<%= pageId ? '/admin/pages/'+pageId+'/apply-template/'+t.id : '/admin/pages/new?template='+t.id %>"
         data-name="<%= (t.name||'').toLowerCase() %>" data-id="<%= (t.id||'').toLowerCase() %>">
        <div class="tpl-preview">
          <div class="tpl-swatch" style="background:<%= p.accent %>"></div>
          <div class="tpl-swatch2" style="background:<%= p.fg %>"></div>
        </div>
        <div class="tpl-body">
          <div class="tpl-name"><%= t.name %></div>
          <div class="tpl-meta"><%= t.id %></div>
          <div class="tpl-pages"><%= t.pages_count %> page<%= t.pages_count !== 1 ? 's' : '' %></div>
        </div>
      </a>
    <% }) %>
  </div>

  <div class="empty-state" id="emptyState" style="display:none">
    No templates match your search.
  </div>
</div>

<script>
function filterTemplates() {
  const q = document.getElementById('searchTpl').value.toLowerCase();
  let visible = 0;
  document.querySelectorAll('.tpl').forEach(el => {
    const match = !q || el.dataset.name.includes(q) || el.dataset.id.includes(q);
    el.classList.toggle('hidden', !match);
    if (match) visible++;
  });
  document.getElementById('emptyState').style.display = visible ? 'none' : '';
}
</script>
</body>
</html>
