<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= pageContent.headline %> — <%= tpl.name %></title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root { --bg:<%= tpl.palette.bg %>; --card:<%= tpl.palette.card %>; --fg:<%= tpl.palette.fg %>; --accent:<%= tpl.palette.accent %>; --accent2:<%= tpl.palette.accent2 %>; }
  * { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:'Inter',system-ui; background:var(--bg); color:var(--fg); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; }
  .auth { background:var(--card); border-radius:20px; padding:36px 28px; width:100%; max-width:440px; }
  .logo { width:56px; height:56px; border-radius:16px; background:linear-gradient(135deg,var(--accent),var(--accent2)); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:800; font-size:1.6rem; margin:0 auto 24px; }
  .logo-svg { display:block; margin:0 auto 24px; }
  h1 { font-size:1.3rem; text-align:center; margin-bottom:6px; font-weight:800; }
  .sub { text-align:center; font-size:.9rem; opacity:.75; margin-bottom:22px; }
  .otp-wrap { display:flex; gap:8px; justify-content:center; margin:22px 0; }
  .otp-wrap input { width:52px; height:60px; text-align:center; font-size:1.6rem; font-weight:800; border:2px solid rgba(255,255,255,.12); border-radius:12px; background:rgba(0,0,0,.2); color:var(--fg); font-family:inherit; }
  .otp-wrap input:focus { outline:none; border-color:var(--accent); }
  button { padding:15px; border:0; border-radius:12px; background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#fff; font-size:1.05rem; font-weight:800; cursor:pointer; font-family:inherit; width:100%; }
  button:disabled { opacity:.5; cursor:not-allowed; }
  .timer { color:var(--accent); font-weight:700; }

