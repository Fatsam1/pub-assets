<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>لوحة البيدجز</title>
<style>
  * { box-sizing:border-box; }
  body { font-family:system-ui,Tahoma; background:#0b0f19; color:#eef2ff; margin:0; padding:24px; }
  .wrap { max-width:1200px; margin:auto; }

  /* ── Header ─────────────────────────────────────── */
  .top-bar { display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; flex-wrap:wrap; gap:12px; }
  .top-bar h1 { margin:0; font-size:1.5rem; display:flex; align-items:center; gap:10px; }
  .top-actions { display:flex; gap:8px; flex-wrap:wrap; }

  /* ── Stat cards ──────────────────────────────────── */
  .stats { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:28px; }
  .stat { background:#151b2b; padding:20px 24px; border-radius:16px; border:1px solid #ffffff0a; position:relative; overflow:hidden; }
  .stat::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:var(--accent,#5b8cff); }
  .stat b { display:block; font-size:2.1rem; font-weight:700; color:var(--accent,#8ab4ff); line-height:1.1; }
  .stat span { font-size:.82rem; opacity:.55; margin-top:4px; display:block; }
  .stat-pages { --accent:#5b8cff; }
  .stat-views { --accent:#22d3ee; }
  .stat-leads { --accent:#4ade80; }

  /* ── Search ──────────────────────────────────────── */
  .search-bar { display:flex; gap:10px; margin-bottom:18px; flex-wrap:wrap; }
  .search-bar input { flex:1; min-width:180px; padding:9px 14px; border-radius:9px; border:1px solid #ffffff18; background:#151b2b; color:#eef2ff; font-size:.9rem; }
  .search-bar input:focus { outline:none; border-color:#5b8cff66; }
  .search-bar select { padding:9px 12px; border-radius:9px; border:1px solid #ffffff18; background:#151b2b; color:#eef2ff; font-size:.9rem; cursor:pointer; }

  /* ── Table ───────────────────────────────────────── */
  .tbl-wrap { background:#151b2b; border-radius:16px; overflow:hidden; border:1px solid #ffffff08; }
  table { width:100%; border-collapse:collapse; }
  th,td { padding:13px 14px; text-align:right; border-bottom:1px solid #ffffff09; font-size:.88rem; }
  th { background:#1c2436; font-size:.78rem; opacity:.7; font-weight:600; letter-spacing:.03em; text-transform:uppercase; }
  tr:last-child td { border-bottom:none; }
  tr:hover td { background:#ffffff04; }

  /* ── Pills ───────────────────────────────────────── */
  .pill { padding:3px 10px; border-radius:99px; font-size:.76rem; font-weight:600; display:inline-block; white-space:nowrap; }
  .pill-on  { background:#16a34a22; color:#4ade80; border:1px solid #4ade8033; }
  .pill-off { background:#ef444422; color:#f87171; border:1px solid #f8717133; }
  .pill-online  { background:#1e3a8a22; color:#93c5fd; border:1px solid #93c5fd33; }
  .pill-offline { background:#78350f22; color:#fcd34d; border:1px solid #fcd34d33; }

  /* ── Brand dot ───────────────────────────────────── */
  .brand-dot { width:8px; height:8px; border-radius:50%; background:#5b8cff; display:inline-block; margin-left:6px; flex-shrink:0; }

  /* ── Buttons ─────────────────────────────────────── */
  .btn { background:#5b8cff; color:#fff; padding:9px 16px; border-radius:9px; text-decoration:none; border:0; cursor:pointer; font-size:.88rem; display:inline-block; white-space:nowrap; }
  .btn:hover { background:#4a7be8; }
  .btn-sm { padding:6px 12px; font-size:.8rem; border-radius:7px; }
  .btn-outline { background:transparent; border:1px solid #5b8cff44; color:#8ab4ff; }
  .btn-outline:hover { background:#5b8cff11; }

  /* ── Leads bar ───────────────────────────────────── */
  .leads-bar { display:flex; align-items:center; gap:6px; }
  .leads-bar .count { font-weight:700; color:#4ade80; }
  .leads-mini { height:4px; border-radius:2px; background:#4ade8033; min-width:4px; transition:width .3s; }

  /* ── Pagination ──────────────────────────────────── */
  .pagination { display:flex; justify-content:center; align-items:center; gap:8px; margin-top:22px; }
  .pagination a { padding:7px 14px; border-radius:8px; background:#151b2b; color:#8ab4ff; text-decoration:none; border:1px solid #ffffff10; font-size:.88rem; }
  .pagination a:hover { background:#1c2436; }
  .pagination .pg-info { color:#8ab4ff; font-size:.88rem; opacity:.7; }

  /* ── Empty state ─────────────────────────────────── */
  .empty { text-align:center; padding:48px; opacity:.35; font-size:1.05rem; }

  @media(max-width:700px){
    .stats { grid-template-columns:1fr; }
    th:nth-child(3),td:nth-child(3),
    th:nth-child(5),td:nth-child(5) { display:none; }
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- ── Top bar ───────────────────────────────────── -->
  <div class="top-bar">
    <h1>🎯 لوحة البيدجز</h1>
    <div class="top-actions">
      <a class="btn btn-outline" href="/admin/templates">🎨 قوالب</a>
      <a class="btn" href="/admin/pages/new">+ جديدة</a>
      <form method="POST" action="/admin/logout" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-outline">خروج</button>
      </form>
    </div>
  </div>

  <!-- ── Stat cards ─────────────────────────────────── -->
  <div class="stats">
    <div class="stat stat-pages">
      <b><%= totals.pages %></b>
      <span>إجمالي الصفحات</span>
    </div>
    <div class="stat stat-views">
      <b><%= totals.views %></b>
      <span>إجمالي المشاهدات</span>
    </div>
    <div class="stat stat-leads">
      <b><%= totals.leads %></b>
      <span>إجمالي الليدز</span>
    </div>
  </div>

  <!-- ── Search / filter ───────────────────────────── -->
  <div class="search-bar">
    <input type="text" id="search" placeholder="🔍  ابحث عن صفحة..." oninput="filterTable()">
    <select id="filterStatus" onchange="filterTable()">
      <option value="">كل الحالات</option>
      <option value="on">مفعّلة</option>
      <option value="off">موقوفة</option>
    </select>
    <select id="filterMode" onchange="filterTable()">
      <option value="">كل المودات</option>
      <option value="online">أونلاين</option>
      <option value="offline">أوفلاين</option>
    </select>
  </div>

  <!-- ── Table ─────────────────────────────────────── -->
  <div class="tbl-wrap">
    <table id="pagesTable">
      <thead>
        <tr>
          <th>#</th>
          <th>العنوان</th>
          <th>القالب</th>
          <th>الرابط</th>
          <th>الحالة</th>
          <th>المود</th>
          <th>مشاهدات</th>
          <th>ليدز</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% pages.forEach(p => {
          const isOn = p.active == 1;
          const isOffline = p.mode === 'offline';
        %>
        <tr data-status="<%= isOn ? 'on' : 'off' %>" data-mode="<%= isOffline ? 'offline' : 'online' %>" data-title="<%= (p.title||'').toLowerCase() %>" data-tpl="<%= (p.template_name||'').toLowerCase() %>">
          <td style="opacity:.45;font-size:.8rem"><%= p.id %></td>
          <td>
            <span class="brand-dot" style="background:<%= isOn ? '#4ade80' : '#f87171' %>"></span>
            <%= p.title %>
          </td>
          <td style="font-size:.8rem;opacity:.55"><%= p.template_name %></td>
          <td>
            <a href="/p/<%= p.slug %>" target="_blank" style="color:#8ab4ff;font-size:.8rem">/p/<%= p.slug %></a>
          </td>
          <td>
            <span class="pill <%= isOn ? 'pill-on' : 'pill-off' %>">
              <%= isOn ? '✅ مفعّلة' : '⛔ موقوفة' %>
            </span>
          </td>
          <td>
            <span class="pill <%= isOffline ? 'pill-offline' : 'pill-online' %>">
              <%= isOffline ? '📴 أوفلاين' : '🌐 أونلاين' %>
            </span>
          </td>
          <td style="font-size:.85rem;opacity:.8"><%= p.views || 0 %></td>
          <td>
            <div class="leads-bar">
              <span class="count"><%= p.leads_count %></span>
              <% if (p.leads_count > 0) { %>
                <div class="leads-mini" style="width:<%= Math.min(p.leads_count * 6, 40) %>px; background:<%= p.leads_count >= 5 ? '#4ade80aa' : '#22d3eeaa' %>"></div>
              <% } %>
            </div>
          </td>
          <td>
            <a class="btn btn-sm" href="/admin/pages/<%= p.id %>">إدارة</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (!pages.length) { %>
      <div class="empty">مفيش صفحات لسه — <a href="/admin/pages/new" style="color:#8ab4ff">أنشئ أول صفحة</a></div>
    <% } %>
  </div>

  <!-- ── Pagination ─────────────────────────────────── -->
  <div class="pagination">
    <% if (hasPrev) { %>
      <a href="/admin?page=<%= currentPage - 1 %>">&#8594; السابق</a>
    <% } %>
    <span class="pg-info">صفحة <%= currentPage %> من <%= totalPages %></span>
    <% if (hasNext) { %>
      <a href="/admin?page=<%= currentPage + 1 %>">التالي &#8592;</a>
    <% } %>
  </div>

</div>

<script>
function filterTable() {
  const q      = document.getElementById('search').value.toLowerCase();
  const status = document.getElementById('filterStatus').value;
  const mode   = document.getElementById('filterMode').value;
  document.querySelectorAll('#pagesTable tbody tr').forEach(tr => {
    const title  = tr.dataset.title || '';
    const tpl    = tr.dataset.tpl   || '';
    const matchQ = !q || title.includes(q) || tpl.includes(q);
    const matchS = !status || tr.dataset.status === status;
    const matchM = !mode   || tr.dataset.mode   === mode;
    tr.style.display = (matchQ && matchS && matchM) ? '' : 'none';
  });
}
</script>
</body>
</html>
