# HostPanel config — copy to .env (kept OUTSIDE public_html on the server) and fill in.
# On the server the real file lives at /home/<cpanelUser>/.env  (one dir above public_html).

# WHM (the reseller hosting server)
WHM_HOST=169.58.26.102
WHM_USER=your_whm_reseller_user
WHM_API_TOKEN=your_whm_api_token

# Cloudflare — Global API Key (full account access; needed for creating zones)
CF_GLOBAL_KEY=your_cloudflare_global_api_key
CF_EMAIL=your_cloudflare_account_email
CF_ACCOUNT_ID=your_cloudflare_account_id
# Optional scoped token fallback (used only if CF_GLOBAL_KEY is empty)
CLOUDFLARE_API_TOKEN=

# Telegram login bot
TG_BOT_TOKEN=your_bot_token_from_botfather
TG_BOT_USERNAME=your_bot_username_without_at
TG_ALLOWED_CHAT_ID=your_telegram_chat_id_the_super_admin
